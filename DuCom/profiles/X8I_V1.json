{
  "SchemaVersion": 1,
  "Name": "X8I_V1",
  "Revision": "1.0",
  "Notes": "基于 spp产测指令提供-250604。重复组队操作合为一个复合命令。XX 参数以 00 占位，写入前自行修改；SPP 专用项不能通过铜柱 UART 使用。协议未提供设置MAC的字节，未虚构该项。",
  "Protocol": { "BaudRate": 9600, "TxHeader": "55 AA", "RxHeader": "55 AA", "LengthOffset": 2, "LengthSize": 1, "LengthAdjustment": 4, "PayloadOffset": 3, "Checksum": "Crc8Maxim" },
  "LoopIntervalMs": 500,
  "Commands": [
    { "Id": "mac", "Name": "读取MAC地址", "Hex": "94 01", "ResponseMatch": "94 02", "DelayMs": 200, "Fields": [{ "Name": "MAC", "Type": "Mac", "Offset": 5 }] },
    { "Id": "battery", "Name": "获取电池电量", "Hex": "97 01", "ResponseMatch": "97 02", "DelayMs": 200, "Fields": [{ "Name": "电量", "Type": "UInt8", "Offset": 5, "Unit": "%" }] },
    { "Id": "voltage", "Name": "获取电池电压", "Hex": "98 01", "ResponseMatch": "98 02", "DelayMs": 200, "Fields": [{ "Name": "电压", "Type": "UInt16", "Offset": 5, "Unit": "mV" }] },
    { "Id": "pairing", "Name": "耳机组队", "Enabled": false, "Hex": "01", "DelayMs": 1000, "SuccessText": "组队指令完成",
      "Steps": [
        { "Id": "read-left", "Name": "获取左耳数据", "Channel": "Left", "PairingStep": true, "Hex": "01 02", "ResponseMatch": "01", "FixedResponseLength": 36, "DelayMs": 200 },
        { "Id": "read-right", "Name": "获取右耳数据", "Channel": "Right", "PairingStep": true, "Hex": "01 01", "ResponseMatch": "01", "FixedResponseLength": 36, "DelayMs": 200 },
        { "Id": "write-left", "Name": "左耳写入对耳数据", "Channel": "Left", "PairingStep": true, "Hex": "02", "ResponseMatch": "02", "FixedResponseLength": 5, "ResponseSourceId": "read-right", "ResponseSourceChannel": "Right", "ResponseSourceOffset": 4, "ResponseSourceLength": 31, "DelayMs": 200 },
        { "Id": "write-right", "Name": "右耳写入对耳数据", "Channel": "Right", "PairingStep": true, "Hex": "02", "ResponseMatch": "02", "FixedResponseLength": 5, "ResponseSourceId": "read-left", "ResponseSourceChannel": "Left", "ResponseSourceOffset": 4, "ResponseSourceLength": 31, "DelayMs": 1000 }
      ]
    },
    { "Id": "peer-mac", "Name": "读取对耳MAC地址", "Hex": "96 01", "ResponseMatch": "96 02", "DelayMs": 200, "Fields": [{ "Name": "对耳MAC", "Type": "Mac", "Offset": 5 }] },
    { "Id": "dut", "Name": "进入DUT", "Enabled": false, "Hex": "21 04", "ResponseMatch": "21 04", "DelayMs": 200 },
    { "Id": "bt-pair", "Name": "BT配对", "Enabled": false, "Hex": "92 01", "ResponseMatch": "92 02" },
    { "Id": "unpair", "Name": "TWS解配", "Enabled": false, "Hex": "03 03", "ResponseMatch": "03" },
    { "Id": "reset", "Name": "恢复出厂设置", "Enabled": false, "Hex": "08", "ResponseMatch": "08" },
    { "Id": "shipping", "Name": "船运模式", "Enabled": false, "Hex": "21 0A", "ResponseMatch": "21 0A" },
    { "Id": "ff-mic", "Name": "打开FF MIC（仅SPP/HFP）", "Enabled": false, "RawFrame": true, "Hex": "0A 0B 01 BB 55 42 20 00 00 00 02", "MatchOffset": 0, "ResponseMatch": "0A 0B 01 BB 55 21 10 00 00 00 01", "FixedResponseLength": 11, "Frame": { "TxHeader": "0A 0B", "RxHeader": "0A 0B", "Checksum": "None" } },
    { "Id": "fb-mic", "Name": "打开FB MIC（仅SPP/HFP）", "Enabled": false, "RawFrame": true, "Hex": "0A 0B 01 BB 55 CE E1 00 00 00 0E", "MatchOffset": 0, "ResponseMatch": "0A 0B 01 BB 55 21 10 00 00 00 01", "FixedResponseLength": 11, "Frame": { "TxHeader": "0A 0B", "RxHeader": "0A 0B", "Checksum": "None" } },
    { "Id": "talk-mic", "Name": "打开TALK MIC（仅SPP/HFP）", "Enabled": false, "RawFrame": true, "Hex": "0A 0B 01 BB 55 21 10 00 00 00 01", "MatchOffset": 0, "ResponseMatch": "0A 0B 01 BB 55 21 10 00 00 00 01", "FixedResponseLength": 11, "Frame": { "TxHeader": "0A 0B", "RxHeader": "0A 0B", "Checksum": "None" } },
    { "Id": "enc", "Name": "打开ENC全部算法（仅SPP/HFP）", "Enabled": false, "RawFrame": true, "Hex": "0A 0B 01 BB 55 63 30 00 00 00 03", "MatchOffset": 0, "ResponseMatch": "0A 0B 01 BB 55 21 10 00 00 00 01", "FixedResponseLength": 11, "Frame": { "TxHeader": "0A 0B", "RxHeader": "0A 0B", "Checksum": "None" } },
    { "Id": "dns-on", "Name": "打开DNS（仅SPP/HFP）", "Enabled": false, "RawFrame": true, "Hex": "0A 0B 01 BB 55 84 40 00 00 00 04", "MatchOffset": 0, "ResponseMatch": "0A 0B 01 BB 55 21 10 00 00 00 01", "FixedResponseLength": 11, "Frame": { "TxHeader": "0A 0B", "RxHeader": "0A 0B", "Checksum": "None" } },
    { "Id": "dns-off", "Name": "关闭DNS（仅SPP/HFP）", "Enabled": false, "RawFrame": true, "Hex": "0A 0B 01 BB 55 A5 50 00 00 00 05", "MatchOffset": 0, "ResponseMatch": "0A 0B 01 BB 55 21 10 00 00 00 01", "FixedResponseLength": 11, "Frame": { "TxHeader": "0A 0B", "RxHeader": "0A 0B", "Checksum": "None" } },
    { "Id": "anc-on", "Name": "打开ANC", "Enabled": false, "Hex": "A6 01", "ResponseMatch": "A6 02" },
    { "Id": "anc-off", "Name": "关闭ANC", "Enabled": false, "Hex": "A7 01", "ResponseMatch": "A7 02" },
    { "Id": "bd", "Name": "读取BD地址", "Enabled": false, "Hex": "93 01", "ResponseMatch": "93 02", "Fields": [{ "Name": "BD", "Type": "Mac", "Offset": 5 }] },
    { "Id": "ntc", "Name": "NTC读取", "Enabled": false, "Hex": "99 01", "ResponseMatch": "99 02", "Fields": [{ "Name": "NTC", "Type": "UInt16", "Offset": 5 }] },
    { "Id": "version", "Name": "获取软件版本", "Enabled": false, "Hex": "9A 01", "ResponseMatch": "9A 02", "Fields": [{ "Name": "版本", "Type": "Version", "Length": 4, "Offset": 5 }] },
    { "Id": "sn-read", "Name": "读BT SN", "Enabled": false, "Hex": "9B 01", "ResponseMatch": "9B 02", "Fields": [{ "Name": "SN", "Type": "Ascii", "Length": 16, "Offset": 5 }] },
    { "Id": "sn-write", "Name": "写BT SN（需填16字节）", "Enabled": false, "Hex": "9C 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00", "ResponseMatch": "9C 02" },
    { "Id": "model-read", "Name": "读ModelID", "Enabled": false, "Hex": "9D 01", "ResponseMatch": "9D 02", "Fields": [{ "Name": "ModelID", "Type": "UInt8", "Offset": 5 }] },
    { "Id": "model-write", "Name": "写ModelID", "Enabled": false, "Hex": "9E 01 01", "ResponseMatch": "9E 02" },
    { "Id": "limit-on", "Name": "进入限电模式", "Enabled": false, "Hex": "9F 01 01", "ResponseMatch": "9F 02" },
    { "Id": "limit-read", "Name": "查询限电模式", "Enabled": false, "Hex": "A0 01", "ResponseMatch": "A0 02", "Fields": [{ "Name": "限电", "Type": "UInt8", "Offset": 5 }] },
    { "Id": "limit-off", "Name": "退出限电模式", "Enabled": false, "Hex": "A1 01 00", "ResponseMatch": "A1 02" },
    { "Id": "ship-region-write", "Name": "设置耳机出货区域", "Enabled": false, "Hex": "A2 01 01", "ResponseMatch": "A2 02" },
    { "Id": "ship-region-read", "Name": "读取耳机出货区域", "Enabled": false, "Hex": "A3 01", "ResponseMatch": "A3 02", "Fields": [{ "Name": "区域", "Type": "UInt8", "Offset": 5 }] },
    { "Id": "token-write", "Name": "设置token（需填16字节）", "Enabled": false, "Hex": "A4 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00", "ResponseMatch": "A4 02" },
    { "Id": "token-read", "Name": "读取token", "Enabled": false, "Hex": "A5 01", "ResponseMatch": "A5 02", "Fields": [{ "Name": "token", "Type": "Hex", "Length": 16, "Offset": 5 }] },
    { "Id": "freq-write", "Name": "设置频偏（需填参数）", "Enabled": false, "Hex": "A8 01 00 00 00 00", "ResponseMatch": "A8 02", "Fields": [{ "Name": "频偏", "Type": "Int32", "Offset": 5, "Unit": "mHz" }] },
    { "Id": "phone-state", "Name": "查询手机连接状态", "Enabled": false, "Hex": "A9 01", "ResponseMatch": "A9 02", "Fields": [{ "Name": "配对状态", "Type": "UInt8", "Offset": 5 }, { "Name": "连接记录", "Type": "UInt8", "Offset": 6 }, { "Name": "OTA状态", "Type": "UInt8", "Offset": 7 }] },
    { "Id": "power-off", "Name": "产测关机", "Enabled": false, "Hex": "AA 01", "ResponseMatch": "AA 02" },
    { "Id": "freq-enter", "Name": "进入偏频", "Enabled": false, "Hex": "AB 01", "ResponseMatch": "AB 02" },
    { "Id": "two-macs", "Name": "读取两个MAC地址", "Enabled": false, "Hex": "AC 01", "ResponseMatch": "AC 02", "Fields": [{ "Name": "主耳MAC", "Type": "Mac", "Offset": 5 }, { "Name": "副耳MAC", "Type": "Mac", "Offset": 11 }] },
    { "Id": "rf-enter", "Name": "进入非信令模式", "Enabled": false, "Hex": "AD 01", "ResponseMatch": "AD 02" },
    { "Id": "rf-tx", "Name": "非信令发射（需填12字节）", "Enabled": false, "Hex": "AE 01 00 00 00 00 00 00 00 00 00 00 00 00", "ResponseMatch": "AE 02" },
    { "Id": "rf-rx", "Name": "非信令接收（需填12字节）", "Enabled": false, "Hex": "AF 01 00 00 00 00 00 00 00 00 00 00 00 00", "ResponseMatch": "AF 02" },
    { "Id": "rf-done", "Name": "非信令接收完成（需填参数）", "Enabled": false, "Hex": "B0 01 00 00 00 00 00 00 00", "ResponseMatch": "B0 02", "Fields": [{ "Name": "总包数", "Type": "UInt16", "Offset": 5, "LittleEndian": true }, { "Name": "其他错误", "Type": "UInt16", "Offset": 7, "LittleEndian": true }, { "Name": "CRC错误", "Type": "UInt16", "Offset": 9, "LittleEndian": true }, { "Name": "信号强度", "Type": "UInt8", "Offset": 11 }] },
    { "Id": "rf-reset", "Name": "非信令测试盒重置", "Enabled": false, "Hex": "B1 01", "ResponseMatch": "B1 02" },
    { "Id": "ble-tx", "Name": "BLE非信令发射（需填参数）", "Enabled": false, "Hex": "B2 01 00 00 00 00", "ResponseMatch": "B2 02" },
    { "Id": "ble-rx", "Name": "BLE非信令接收（需填参数）", "Enabled": false, "Hex": "B3 01 00 00 00 00", "ResponseMatch": "B3 02" },
    { "Id": "ble-done", "Name": "BLE非信令接收完成（需填参数）", "Enabled": false, "Hex": "B4 01 00 00 00", "ResponseMatch": "B4 02", "Fields": [{ "Name": "总包数", "Type": "UInt16", "Offset": 5, "LittleEndian": true }, { "Name": "信号强度", "Type": "UInt8", "Offset": 7 }] },
    { "Id": "rf-exit", "Name": "退出非信令模式", "Enabled": false, "Hex": "B5 01", "ResponseMatch": "B5 02" },
    { "Id": "bt-name", "Name": "获取蓝牙名", "Enabled": false, "Hex": "B6 01", "ResponseMatch": "B6 02", "Fields": [{ "Name": "蓝牙名HEX", "Type": "Hex", "Offset": 5, "ToEnd": true }] },
    { "Id": "ntc-state", "Name": "查询NTC状态", "Enabled": false, "Hex": "B7 01", "ResponseMatch": "B7 02", "Fields": [{ "Name": "NTC状态", "Type": "UInt8", "Offset": 5 }] },
    { "Id": "battery-cal", "Name": "校准电量百分比", "Enabled": false, "Hex": "B8 01", "ResponseMatch": "B8 02", "Fields": [{ "Name": "校准状态", "Type": "UInt8", "Offset": 5 }] },
    { "Id": "zhaohua-set", "Name": "兆华设置MAC（需填6字节）", "Enabled": false, "Hex": "B9 01 00 00 00 00 00 00", "ResponseMatch": "B9 02", "Fields": [{ "Name": "MAC", "Type": "Mac", "Offset": 5 }] },
    { "Id": "zhaohua-get", "Name": "兆华查询MAC", "Enabled": false, "Hex": "BA 01", "ResponseMatch": "BA 02", "Fields": [{ "Name": "MAC", "Type": "Mac", "Offset": 5 }] },
    { "Id": "box-off", "Name": "充电仓关机", "Enabled": false, "Hex": "80", "ResponseMatch": "80" },
    { "Id": "bt-name-set", "Name": "设置蓝牙名编号", "Enabled": false, "Hex": "BB 01 00", "ResponseMatch": "BB 02", "Fields": [{ "Name": "名称编号", "Type": "UInt8", "Offset": 5 }] },
    { "Id": "adaptive-off", "Name": "关闭自适应", "Enabled": false, "Hex": "BC 01", "ResponseMatch": "BC 02" },
    { "Id": "region-set", "Name": "设置区域productId", "Enabled": false, "Hex": "BD 01 00", "ResponseMatch": "BD 02" }
  ]
}
