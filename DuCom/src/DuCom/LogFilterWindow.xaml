<ui:FluentWindow x:Class="DuCom.LogFilterWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:behaviors="clr-namespace:DuCom.Behaviors"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="DuCom"
                  Width="560"
                   Height="360"
                  Icon="/Assets/DuCom.ico"
                  MinWidth="380"
                  MinHeight="300"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="Manual">
    <Grid Background="{DynamicResource Brush.LogSurface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="FilterTitleBar"
                     Title="DuCom"
                     ShowMaximize="True"
                     ShowMinimize="True" />

        <StackPanel Grid.Row="1"
                    Margin="12,4,12,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                <ToggleButton x:Name="RecvHexToggle"
                               MinWidth="44"
                               Click="RecvHexToggle_Click">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource Style.FloatToolbarToggle}">
                            <Setter Property="Content" Value="STR" />
                            <Setter Property="ToolTip" Value="{DynamicResource FloatSend.ShowStrToolTip}" />
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Content" Value="HEX" />
                                    <Setter Property="ToolTip" Value="{DynamicResource FloatSend.ShowHexToolTip}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <ToggleButton x:Name="PinLogToggle"
                              MinWidth="56"
                               Margin="8,0,0,0"
                               Style="{StaticResource Style.FloatToolbarToggle}"
                              Content="{DynamicResource FloatSend.FixedScroll}"
                              ToolTip="{DynamicResource FloatSend.FixedScrollToolTip}"
                              Click="PinLogToggle_Click" />
                <Button MinWidth="44"
                         Margin="8,0,0,0"
                         Style="{StaticResource Style.FloatToolbarButton}"
                        Content="{DynamicResource FloatSend.Clear}"
                        Click="Clear_Click" />
                <Button MinWidth="44"
                         Margin="8,0,0,0"
                         Style="{StaticResource Style.FloatToolbarButton}"
                        Content="{DynamicResource FloatSend.Save}"
                        ToolTip="{DynamicResource FloatSend.SaveToolTip}"
                        Click="Save_Click" />
            <ToggleButton x:Name="TopmostToggle"
                          MinWidth="44"
                          Margin="8,0,0,0"
                          Style="{StaticResource Style.FloatToolbarToggle}"
                          Content="{DynamicResource FloatSend.Topmost}"
                          Click="TopmostToggle_Click" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="12,8">
            <TextBox x:Name="KeywordBox"
                     Height="32"
                     Padding="30,0,10,0"
                     VerticalContentAlignment="Center"
                     TextChanged="KeywordBox_TextChanged"
                     ToolTip="{DynamicResource LogFilter.KeywordToolTip}" />
            <ui:SymbolIcon Margin="10,0,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           IsHitTestVisible="False"
                           Symbol="Search24" />
            <TextBlock x:Name="KeywordPlaceholder"
                       Margin="30,0,0,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Style="{DynamicResource Style.MutedText}"
                       Text="{DynamicResource LogFilter.KeywordHint}" />
        </Grid>

        <ListBox x:Name="LogList"
                 Grid.Row="3"
                 Margin="8,0,8,8"
                 Padding="6"
                 BorderThickness="0"
                 Background="Transparent"
                 FontSize="12"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 Style="{StaticResource Style.LogList}"
                 behaviors:ListBoxAutoScrollBehavior.IsEnabled="True">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Text}" FontFamily="Cascadia Mono, Consolas" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="EmptyStateText"
                   Grid.Row="3"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   Style="{DynamicResource Style.MutedText}"
                   Text="{DynamicResource LogFilter.Empty}" />
        <TextBlock x:Name="MatchStatusText"
                   Grid.Row="4"
                   Margin="12,2,12,8"
                   HorizontalAlignment="Right"
                   Style="{DynamicResource Style.MutedText}" />
    </Grid>
</ui:FluentWindow>
