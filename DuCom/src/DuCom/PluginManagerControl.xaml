<UserControl x:Class="DuCom.PluginManagerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:DuCom.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{DynamicResource Brush.TextPrimary}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:PluginRuntimeStateToStringConverter x:Key="PluginRuntimeStateToStringConverter" />
        <converters:PluginStringLabelConverter x:Key="PluginStringLabelConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" MinWidth="180" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{DynamicResource Style.Panel}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{DynamicResource Style.SectionTitle}" Text="{DynamicResource Plugins.Installed}" />
                <StackPanel Grid.Row="1" Margin="0,4,0,10">
                    <Button Style="{StaticResource Style.ToolbarPrimary}" Command="{Binding InstallPluginCommand}" Content="{DynamicResource Plugins.Install}" />
                    <WrapPanel Margin="0,6,0,0">
                        <Button Margin="0,0,6,4" Padding="8,4" FontSize="{DynamicResource Fs.Small}" Command="{Binding EnableAllPluginsCommand}" Content="{DynamicResource Plugins.Enable}" />
                        <Button Margin="0,0,6,4" Padding="8,4" FontSize="{DynamicResource Fs.Small}" Command="{Binding DisableAllPluginsCommand}" Content="{DynamicResource Plugins.Disable}" />
                        <Button Margin="0,0,0,4" Padding="8,4" FontSize="{DynamicResource Fs.Small}" Command="{Binding RefreshPluginsCommand}" Content="{DynamicResource Plugins.Refresh}" />
                    </WrapPanel>
                </StackPanel>
                <ListBox Grid.Row="2" ItemsSource="{Binding Plugins}" SelectedItem="{Binding SelectedPlugin}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource Style.EditorListItem}">
                            <Setter Property="Padding" Value="8,10" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                <TextBlock Margin="0,4,0,0" FontSize="{DynamicResource Fs.Small}" Foreground="{DynamicResource Brush.TextSecondary}"
                                           Text="{Binding State, Converter={StaticResource PluginRuntimeStateToStringConverter}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Expander Grid.Row="3" Margin="0,10,0,0" Header="{DynamicResource Plugins.Advanced}">
                    <StackPanel Margin="0,8,0,0">
                        <CheckBox IsChecked="{Binding SafeStartAllPlugins, Mode=TwoWay}">
                            <TextBlock Text="{DynamicResource Plugins.SafeStart}" TextWrapping="Wrap" />
                        </CheckBox>
                        <Button Margin="0,10,0,0" Command="{Binding OpenPluginFolderCommand}" Content="{DynamicResource Plugins.OpenFolder}" />
                        <TextBlock Margin="0,8,0,0" FontSize="{DynamicResource Fs.Small}" Text="{Binding BudgetSummary}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </StackPanel>
                </Expander>
            </Grid>
        </Border>
        <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,4,0">
                <StackPanel Visibility="{Binding IsRowSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Style="{DynamicResource Style.SettingsPageTitle}" Text="{Binding SelectedPlugin.Name}" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,4,0,10">
                        <TextBlock x:Name="PluginVersionText" Margin="0,0,12,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding SelectedPlugin.Version}" />
                        <TextBlock Foreground="{DynamicResource Brush.Accent}" Text="{DynamicResource Plugins.BuiltIn}"
                                   Visibility="{Binding SelectedPlugin.IsBuiltIn, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </WrapPanel>
                    <TextBlock Margin="0,0,0,14" Style="{DynamicResource Style.MutedText}" Text="{Binding SelectedPlugin.Description}" />
                    <WrapPanel Margin="0,0,0,8" IsEnabled="{Binding CanToggle}">
                        <Button x:Name="EnablePluginButton" Margin="0,0,6,6" Command="{Binding EnablePluginCommand}" CommandParameter="{Binding SelectedPlugin}" Content="{DynamicResource Plugins.Enable}" />
                        <Button x:Name="DisablePluginButton" Margin="0,0,6,6" Command="{Binding DisablePluginCommand}" CommandParameter="{Binding SelectedPlugin}" Content="{DynamicResource Plugins.Disable}" />
                        <Button Margin="0,0,6,6" Command="{Binding RestartPluginCommand}" CommandParameter="{Binding SelectedPlugin}" Content="{DynamicResource Plugins.Restart}" />
                        <Button Margin="0,0,6,6" Command="{Binding UninstallSelectedCommand}" IsEnabled="{Binding CanUninstall}" Content="{DynamicResource Plugins.Uninstall}" />
                    </WrapPanel>
                    <Button Margin="0,0,0,14" HorizontalAlignment="Left" Style="{StaticResource Style.ToolbarPrimary}"
                            Command="{Binding OpenPluginCommand}" CommandParameter="{Binding SelectedPlugin}"
                            IsEnabled="{Binding SelectedPlugin.IsActive}" Content="{DynamicResource Plugins.OpenFeature}" />
                    <Border Style="{DynamicResource Style.SettingsCard}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Style.SectionTitle}" Text="{DynamicResource Plugins.RunState}" />
                            <TextBlock Text="{Binding SelectedStateText}" Foreground="{DynamicResource Brush.Accent}" />
                            <TextBlock Margin="0,8,0,0" Text="{Binding SelectedPlugin.FaultReason}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Danger}"
                                       Visibility="{Binding SelectedPlugin.HasFaultReason, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Margin="0,8,0,0" Text="{DynamicResource Plugins.PendingRestart}" Foreground="{DynamicResource Brush.Caution}"
                                       Visibility="{Binding SelectedPlugin.PendingUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource Style.SettingsCard}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Style.SectionTitle}" Text="{DynamicResource Plugins.Info}" />
                            <TextBlock Style="{DynamicResource Style.FieldLabel}" Text="{DynamicResource Plugins.Id}" />
                            <TextBlock Text="{Binding SelectedPlugin.Id}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,10,0,4" Style="{DynamicResource Style.FieldLabel}" Text="{DynamicResource Plugins.WorkerPid}" />
                            <TextBlock Text="{Binding SelectedPlugin.WorkerPid}" />
                            <TextBlock Margin="0,10,0,4" Style="{DynamicResource Style.FieldLabel}" Text="{DynamicResource Plugins.Capabilities}" />
                            <ItemsControl ItemsSource="{Binding SelectedPlugin.Capabilities}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,6,6" Padding="8,4" Background="{DynamicResource Brush.ControlSurface}" CornerRadius="4"><TextBlock Text="{Binding Path=., Converter={StaticResource PluginStringLabelConverter}}" FontSize="{DynamicResource Fs.Small}" /></Border></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,10,0,4" Style="{DynamicResource Style.FieldLabel}" Text="{DynamicResource Plugins.Permissions}" />
                            <ItemsControl ItemsSource="{Binding SelectedPlugin.Permissions}">
                                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,0,0,6" Text="{Binding Path=., Converter={StaticResource PluginStringLabelConverter}}" TextWrapping="Wrap" FontSize="{DynamicResource Fs.Small}" /></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,10,0,0" Visibility="{Binding SelectedPlugin.HasIntegrationGuide, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Hyperlink Command="{Binding OpenIntegrationGuideCommand}">BES / 恒玄接入文档</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <!-- Keep feedback outside selection-dependent content: installs can fail before selection. -->
                <TextBlock Margin="0,4,0,12" Text="{Binding OperationMessage}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" />
                <Button HorizontalAlignment="Left" Style="{StaticResource Style.ToolbarPrimary}"
                        Command="{Binding ApplyAndRestartCommand}" Content="{DynamicResource Plugins.ApplyRestart}"
                        Visibility="{Binding HasPendingUpdates, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
