<UserControl x:Class="DuCom.PluginManagerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{DynamicResource Brush.TextPrimary}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="PluginStateSegment" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Padding" Value="16,5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Background" Value="{DynamicResource Brush.PanelRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource Brush.PanelSurface}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{DynamicResource Plugins.Installed}" />
                <Button Grid.Row="1" Margin="0,10" HorizontalAlignment="Left" Padding="12,5"
                        Command="{Binding InstallPluginCommand}" Content="{DynamicResource Plugins.Install}" />
                <ListBox Grid.Row="2" ItemsSource="{Binding Plugins}" SelectedItem="{Binding SelectedPlugin}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource Style.EditorListItem}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="10,9" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="6">
                                    <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" Symbol="PuzzlePiece24" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding State}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Expander Grid.Row="3" Margin="0,10,0,0" Header="{DynamicResource Plugins.Advanced}">
                    <StackPanel>
                        <CheckBox Content="{DynamicResource Plugins.SafeStart}" IsChecked="{Binding SafeStartAllPlugins, Mode=TwoWay}" />
                        <Button Margin="0,8,0,0" HorizontalAlignment="Left" Command="{Binding OpenPluginFolderCommand}" Content="{DynamicResource Plugins.OpenFolder}" />
                    </StackPanel>
                </Expander>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource Brush.PanelBorder}" />

        <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,16,22,24">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Padding="8,3" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="8"
                            Visibility="{Binding SelectedPlugin.IsBuiltIn, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Foreground="{DynamicResource Brush.Accent}" Text="{DynamicResource Plugins.BuiltIn}" />
                    </Border>
                    <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding SelectedPlugin.Name}" />
                </DockPanel>
                <TextBlock Margin="0,6,0,0" Style="{DynamicResource Style.MutedText}" Text="{Binding SelectedPlugin.Description}" TextWrapping="Wrap" />

                <Border Margin="0,18,0,0" Padding="3" HorizontalAlignment="Left" CornerRadius="8"
                        Background="{DynamicResource Brush.PanelRaised}" BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1"
                        IsEnabled="{Binding CanToggle}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="4" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Command="{Binding EnablePluginCommand}" CommandParameter="{Binding SelectedPlugin}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PluginStateSegment}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPlugin.IsActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock FontWeight="SemiBold" Text="ON" ToolTip="{DynamicResource Plugins.Enabled.Hint}" />
                    </Button>
                    <Button Grid.Column="2"
                            Command="{Binding DisablePluginCommand}" CommandParameter="{Binding SelectedPlugin}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PluginStateSegment}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPlugin.IsInactive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock FontWeight="SemiBold" Text="OFF" ToolTip="{DynamicResource Plugins.Disabled.Hint}" />
                    </Button>
                </Grid>
                </Border>

                <ui:Button Margin="0,16,0,0" HorizontalAlignment="Left" MinWidth="130" Padding="16,7" Appearance="Primary"
                           Command="{Binding OpenPluginCommand}" CommandParameter="{Binding SelectedPlugin}"
                           IsEnabled="{Binding SelectedPlugin.IsActive}" Content="{DynamicResource Plugins.OpenFeature}" />

                <Border Margin="0,18,0,0" Style="{DynamicResource Style.SettingsCard}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource Style.SectionTitle}" Text="{DynamicResource Plugins.Status}" />
                        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="{Binding SelectedPlugin.State}" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding SelectedPlugin.FaultReason}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Danger}" Visibility="{Binding SelectedPlugin.HasFaultReason, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding OperationMessage}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0" FontWeight="SemiBold" Text="{DynamicResource Plugins.PendingRestart}"
                                   Visibility="{Binding SelectedPlugin.PendingUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Border>
                <ui:Button Margin="0,14,0,0" HorizontalAlignment="Left" Appearance="Primary" Padding="16,7"
                           Command="{Binding ApplyAndRestartCommand}" Content="{DynamicResource Plugins.ApplyRestart}"
                           Visibility="{Binding HasPendingUpdates, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
