<UserControl x:Class="DuCom.PluginManagerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Background="{DynamicResource Brush.PanelSurface}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid Margin="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{DynamicResource Plugins.Installed}" />
            <StackPanel Grid.Row="1" Margin="0,10" Orientation="Horizontal">
                <Button Command="{Binding OpenPluginFolderCommand}" Content="{DynamicResource Tools.OpenPluginFolder}" />
                <Button Margin="8,0,0,0" Command="{Binding RefreshPluginsCommand}" Content="{DynamicResource Connection.Refresh}" />
            </StackPanel>
            <ListBox Grid.Row="2" ItemsSource="{Binding Plugins}" SelectedItem="{Binding SelectedPlugin}">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource Style.EditorListItem}"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="10,9" /></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="32" Height="32" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="6"><ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" Symbol="PuzzlePiece24" /></Border><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,2,0,0" Style="{DynamicResource Style.MutedText}" Text="{Binding Description}" TextTrimming="CharacterEllipsis" /></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <Border Grid.Column="1" Background="{DynamicResource Brush.PanelBorder}" />
        <Grid Grid.Column="2">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsBackgroundPluginSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Margin="22,16,22,24">
                    <TextBlock FontSize="26" FontWeight="SemiBold" Text="{DynamicResource Plugins.BackgroundImage.Name}" />
                    <TextBlock Margin="0,6,0,0" Style="{DynamicResource Style.MutedText}" Text="{DynamicResource Plugins.BackgroundImage.Description}" TextWrapping="Wrap" />
                    <ui:Button Margin="0,18,0,0" HorizontalAlignment="Left" Appearance="Primary" Command="{Binding ToggleBackgroundImageCommand}"><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{DynamicResource Plugins.BackgroundImage.Enable}" /><Style.Triggers><DataTrigger Binding="{Binding BackgroundImageEnabled}" Value="True"><Setter Property="Text" Value="{DynamicResource Plugins.BackgroundImage.Disable}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></ui:Button>
                    <Border Margin="0,18,0,0" Style="{DynamicResource Style.SettingsCard}"><StackPanel>
                        <TextBlock Style="{DynamicResource Style.FieldLabel}" Text="{DynamicResource Plugins.BackgroundImage.Image}" /><TextBox IsReadOnly="True" Text="{Binding BackgroundImagePath}" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,8,0,0"><Button Command="{Binding SelectBackgroundImageCommand}" Content="{DynamicResource Plugins.BackgroundImage.Select}" /><Button Margin="8,0,0,0" Command="{Binding SelectBackgroundImageFolderCommand}" Content="{DynamicResource Plugins.BackgroundImage.SelectFolder}" /><Button Margin="8,0,0,0" Command="{Binding ClearBackgroundImageCommand}" Content="{DynamicResource Plugins.BackgroundImage.Clear}" /></WrapPanel>
                        <TextBlock Margin="0,16,0,4" Style="{DynamicResource Style.FieldLabel}" Text="{DynamicResource Plugins.BackgroundImage.Folder}" /><TextBox IsReadOnly="True" Text="{Binding BackgroundImageFolderPath}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,16,0,4" Style="{DynamicResource Style.FieldLabel}" Text="{DynamicResource Plugins.BackgroundImage.PlaybackMode}" /><ComboBox DisplayMemberPath="DisplayName" ItemsSource="{Binding PlaybackModes}" SelectedItem="{Binding SelectedPlaybackMode}" />
                        <TextBlock Margin="0,16,0,4" Style="{DynamicResource Style.FieldLabel}" Text="{DynamicResource Plugins.BackgroundImage.Interval}" /><TextBox Text="{Binding BackgroundImageIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding ShowNextBackgroundImageCommand}" Content="{DynamicResource Plugins.BackgroundImage.Next}" />
                        <TextBlock Margin="0,16,0,4" Style="{DynamicResource Style.FieldLabel}" Text="{DynamicResource Plugins.BackgroundImage.Opacity}" /><Slider Minimum="0" Maximum="0.8" TickFrequency="0.05" Value="{Binding BackgroundImageOpacity}" /><TextBlock HorizontalAlignment="Right" Style="{DynamicResource Style.MutedText}" Text="{Binding BackgroundImageOpacity, StringFormat={}{0:P0}}" />
                    </StackPanel></Border>
                    <Border MinHeight="180" Margin="0,18,0,0" Background="{DynamicResource Brush.ShellSurface}" BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="8" ClipToBounds="True"><Grid><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource Style.MutedText}" Text="{DynamicResource Plugins.BackgroundImage.Preview}" /><Image Opacity="{Binding BackgroundImageOpacity}" Source="{Binding BackgroundImageSource}" Stretch="UniformToFill" /></Grid></Border>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Margin="22,16" Visibility="{Binding IsExternalPluginSelected, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding SelectedPlugin.Name}" /><TextBlock Margin="0,8,0,0" Style="{DynamicResource Style.MutedText}" Text="{Binding SelectedPlugin.Description}" TextWrapping="Wrap" /><Border Margin="0,20,0,0" Style="{DynamicResource Style.SettingsCard}"><StackPanel><TextBlock Style="{DynamicResource Style.FieldLabel}" Text="{DynamicResource About.Version}" /><TextBlock Text="{Binding SelectedPlugin.Version}" /><TextBlock Margin="0,14,0,0" Style="{DynamicResource Style.FieldLabel}" Text="{DynamicResource Tools.Path}" /><TextBlock Text="{Binding SelectedPlugin.Path}" TextWrapping="Wrap" /></StackPanel></Border></StackPanel>
        </Grid>
    </Grid>
</UserControl>
