<ui:FluentWindow x:Class="DuCom.FeedbackWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource Feedback.Title}"
                 Width="620"
                 Height="540"
                 MinWidth="620"
                 MinHeight="540"
                 Icon="/Assets/DuCom.ico"
                 ExtendsContentIntoTitleBar="True"
                 ResizeMode="NoResize"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar FontSize="16" Title="{DynamicResource Feedback.Title}" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="32,20,32,20">
            <TextBlock FontSize="32" FontWeight="SemiBold" Text="{DynamicResource Feedback.Heading}" />
            <TextBlock Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Style="{DynamicResource Style.MutedText}"
                       Text="{DynamicResource Feedback.Description}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="32,0">
            <Border Margin="0,0,0,12" Style="{DynamicResource Style.SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{DynamicResource Feedback.QQGroup}" />
                        <TextBlock Margin="0,6,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="18" Text="1107820408" />
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Style="{DynamicResource Style.MutedText}" Text="{DynamicResource Feedback.QQHint}" />
                    </StackPanel>
                    <Button Grid.Column="1" MinWidth="96" Margin="20,0,0,0" Click="CopyQQ_Click" Content="{DynamicResource Feedback.CopyGroup}" />
                </Grid>
            </Border>

            <Border Style="{DynamicResource Style.SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="GitHub" />
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Style="{DynamicResource Style.MutedText}" Text="{DynamicResource Feedback.GitHubHint}" />
                        <TextBlock Margin="0,6,0,0">
                            <Hyperlink Click="GitHub_Click" NavigateUri="https://github.com/adu9527/DuCom">
                                <Run Text="https://github.com/adu9527/DuCom" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" MinWidth="96" Margin="20,0,0,0" Click="GitHub_Click" Content="{DynamicResource Feedback.OpenGitHub}" />
                </Grid>
            </Border>
        </StackPanel>

        <Button Grid.Row="3"
                MinWidth="96"
                Margin="0,24,32,28"
                HorizontalAlignment="Right"
                Click="Close_Click"
                Content="{DynamicResource About.Close}" />
    </Grid>
</ui:FluentWindow>
