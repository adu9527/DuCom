<ui:FluentWindow x:Class="DuCom.FeedbackWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:DuCom.Controls"
                 Title="{DynamicResource Feedback.Title}"
                 Width="620"
                 Height="680"
                 MinWidth="620"
                 MinHeight="540"
                 MaxHeight="760"
                 Icon="/Assets/DuCom.ico"
                 ExtendsContentIntoTitleBar="True"
                 ResizeMode="NoResize"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar FontSize="16"
                     Title="{DynamicResource Feedback.Title}"
                     ShowClose="False"
                     ShowMaximize="False"
                     ShowMinimize="False">
            <ui:TitleBar.TrailingContent><controls:WindowCaptionButtons /></ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="32,20,32,20">
            <TextBlock FontSize="32" FontWeight="SemiBold" Text="{DynamicResource Feedback.Heading}" />
            <TextBlock Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Style="{DynamicResource Style.MutedText}"
                       Text="{DynamicResource Feedback.Description}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2"
                      Margin="0,0,8,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,0,24,4">
                <Border Margin="0,0,0,12" Style="{DynamicResource Style.SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{DynamicResource Feedback.QQGroup}" />
                            <TextBlock Margin="0,6,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="18" Text="1107820408" />
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Style="{DynamicResource Style.MutedText}" Text="{DynamicResource Feedback.QQHint}" />
                        </StackPanel>
                        <Button Grid.Column="1" MinWidth="96" Margin="20,0,0,0" Click="CopyQQ_Click" Content="{DynamicResource Feedback.CopyGroup}" />
                    </Grid>
                </Border>

                <Border Margin="0,0,0,12" Style="{DynamicResource Style.SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="GitHub" />
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Style="{DynamicResource Style.MutedText}" Text="{DynamicResource Feedback.GitHubHint}" />
                            <TextBlock Margin="0,6,0,0">
                                <Hyperlink Click="GitHub_Click" NavigateUri="https://github.com/adu9527/DuCom">
                                    <Run Text="https://github.com/adu9527/DuCom" />
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" MinWidth="96" Margin="20,0,0,0" Click="GitHub_Click" Content="{DynamicResource Feedback.OpenGitHub}" />
                    </Grid>
                </Border>

                <Border Style="{DynamicResource Style.SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42"
                                Height="42"
                                Margin="0,1,16,0"
                                VerticalAlignment="Top"
                                Background="{DynamicResource Brush.AccentSoft}"
                                CornerRadius="21">
                            <ui:SymbolIcon HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="20"
                                           Symbol="DocumentText24" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{DynamicResource Feedback.SystemLog}" />
                            <TextBlock Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Style="{DynamicResource Style.MutedText}"
                                       Text="{DynamicResource Feedback.SystemLogHint}" />
                            <TextBlock Margin="0,8,0,0"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Text="{DynamicResource Feedback.SystemLogNote}" />
                        </StackPanel>
                        <ui:Button Grid.Column="2"
                                   MinWidth="126"
                                   Margin="20,0,0,0"
                                   VerticalAlignment="Center"
                                   Appearance="Primary"
                                   Click="OpenSystemLog_Click"
                                   Content="{DynamicResource Feedback.ViewSystemLog}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="3"
                MinWidth="96"
                Margin="0,24,32,28"
                HorizontalAlignment="Right"
                Click="Close_Click"
                Content="{DynamicResource About.Close}" />
    </Grid>
</ui:FluentWindow>
