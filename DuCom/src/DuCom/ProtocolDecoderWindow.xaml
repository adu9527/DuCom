<ui:FluentWindow x:Class="DuCom.ProtocolDecoderWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:controls="clr-namespace:DuCom.Controls"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="{DynamicResource ProtocolDecoder.Title}" Width="1250" Height="780" MinWidth="950" MinHeight="580"
                  Icon="/Assets/DuCom.ico" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowStartupLocation="CenterOwner">
    <Grid Background="{DynamicResource Brush.ShellSurface}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ui:TitleBar Title="{DynamicResource ProtocolDecoder.Title}" ShowClose="False" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.TrailingContent><controls:WindowCaptionButtons ShowMaximize="True" ShowMinimize="True"/></ui:TitleBar.TrailingContent>
        </ui:TitleBar>
        <Border Grid.Row="1" Margin="12,8" Padding="10" Background="{DynamicResource Brush.ToolbarSurface}" BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Analysis.Port}"/><ComboBox x:Name="PortCombo" Width="110" Margin="6,0,12,0" DisplayMemberPath="PortName"/>
                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Analysis.Profile}"/><ComboBox x:Name="ProfileCombo" Width="170" Margin="6,0,12,0" DisplayMemberPath="Name"/>
                <Button x:Name="StartButton" MinWidth="72" Click="Start_Click" Content="{DynamicResource Analysis.Start}"/>
                <Button x:Name="PauseButton" MinWidth="72" Margin="8,0,0,0" Click="Pause_Click" Content="{DynamicResource Analysis.Pause}"/>
                <Button MinWidth="72" Margin="8,0,0,0" Click="Stop_Click" Content="{DynamicResource Analysis.Stop}"/>
                <Button MinWidth="72" Margin="8,0,0,0" Click="Clear_Click" Content="{DynamicResource FloatSend.Clear}"/>
                <Button MinWidth="72" Margin="8,0,0,0" Click="Export_Click" Content="{DynamicResource Analysis.Export}"/>
                <Button Margin="18,0,0,0" Click="Reload_Click" Content="{DynamicResource Analysis.ReloadConfig}"/>
                <Button Margin="8,0,0,0" Click="OpenConfig_Click" Content="{DynamicResource Analysis.OpenConfig}"/>
                <Button Margin="8,0,0,0" Click="ResetConfig_Click" Content="{DynamicResource Analysis.ResetTemplates}"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2" Margin="12,0,12,8">
            <Grid.RowDefinitions><RowDefinition Height="3*"/><RowDefinition Height="6"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource Brush.PanelSurface}" BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="8">
                <DataGrid x:Name="FrameGrid" ItemsSource="{Binding Frames}" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="FrameGrid_SelectionChanged"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="110" Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" Header="{DynamicResource Analysis.Time}"/>
                        <DataGridTextColumn Width="80" Binding="{Binding Direction}" Header="{DynamicResource Analysis.Direction}"/>
                        <DataGridTextColumn Width="120" Binding="{Binding Protocol}" Header="{DynamicResource Analysis.Protocol}"/>
                        <DataGridTextColumn Width="150" Binding="{Binding Type}" Header="{DynamicResource Analysis.Type}"/>
                        <DataGridTextColumn Width="70" Binding="{Binding Length}" Header="{DynamicResource Analysis.Length}"/>
                        <DataGridTextColumn Width="90" Binding="{Binding Integrity}" Header="{DynamicResource Analysis.Integrity}"/>
                        <DataGridTextColumn Width="*" Binding="{Binding Summary}" Header="{DynamicResource Analysis.Summary}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch"/>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                <Border Padding="8" Background="{DynamicResource Brush.PanelSurface}" BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="8">
                    <TreeView x:Name="FieldTree" SelectedItemChanged="FieldTree_SelectedItemChanged"/>
                </Border>
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>
                <Border Grid.Column="2" Padding="8" Background="{DynamicResource Brush.PanelSurface}" BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="8">
                    <TabControl><TabItem Header="{DynamicResource Analysis.Hex}"><TextBox x:Name="HexText" FontFamily="Consolas" IsReadOnly="True" TextWrapping="Wrap"/></TabItem>
                    <TabItem Header="{DynamicResource Analysis.Ascii}"><TextBox x:Name="AsciiText" FontFamily="Consolas" IsReadOnly="True" TextWrapping="Wrap"/></TabItem>
                    <TabItem Header="{DynamicResource Analysis.Diagnostics}"><TextBox x:Name="DiagnosticText" IsReadOnly="True" TextWrapping="Wrap"/></TabItem></TabControl>
                </Border>
            </Grid>
        </Grid>
        <DockPanel Grid.Row="3" Margin="14,0,14,10"><TextBlock x:Name="StatusText" Foreground="{DynamicResource Brush.TextSecondary}"/><TextBlock x:Name="GapText" DockPanel.Dock="Right" Foreground="{DynamicResource Brush.Warning}"/></DockPanel>
    </Grid>
</ui:FluentWindow>
