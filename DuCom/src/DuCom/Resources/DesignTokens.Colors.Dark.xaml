<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Neutral graphite palette with a single system-blue accent.
         Three surface levels only: canvas / panel / card. Hairlines replace hard borders
         so 1px edges stay invisible at 100-200% DPI scaling. -->
    <SolidColorBrush x:Key="Brush.ShellSurface" Color="#FF09090B" />
    <SolidColorBrush x:Key="Brush.PanelSurface" Color="#FF18181B" />
    <SolidColorBrush x:Key="Brush.PanelRaised" Color="#FF202023" />
    <SolidColorBrush x:Key="Brush.PanelBorder" Color="#FF303036" />
    <SolidColorBrush x:Key="Brush.PanelBorderStrong" Color="#FF3F3F46" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FFF4F4F5" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FFB4B4BD" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#FFA1A1AA" />
    <!-- Log surface sits a touch darker than the panel so ANSI colours keep their punch. -->
    <SolidColorBrush x:Key="Brush.LogSurface" Color="#FF121214" />
    <SolidColorBrush x:Key="Brush.LogText" Color="#FFD6D9E0" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF60A5FA" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#2660A5FA" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FF93C5FD" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FF3B82F6" />
    <SolidColorBrush x:Key="Brush.FocusStroke" Color="#FF60A5FA" />
    <SolidColorBrush x:Key="Brush.Success" Color="#FF30D158" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFFFD60A" />
    <SolidColorBrush x:Key="Brush.SearchMatchBackground" Color="#E6FFD60A" />
    <SolidColorBrush x:Key="Brush.SearchMatchForeground" Color="#FF17171A" />
    <SolidColorBrush x:Key="Brush.Caution" Color="#FFFFCC33" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FFFF453A" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#2930D158" />
    <SolidColorBrush x:Key="Brush.CautionSoft" Color="#29FFCC33" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#29FF453A" />
    <SolidColorBrush x:Key="Brush.StatusIdle" Color="#FF8B8B95" />
    <SolidColorBrush x:Key="Brush.RowHover" Color="#FF2A2A2E" />
    <SolidColorBrush x:Key="Brush.RowSelected" Color="#FF303036" />
    <SolidColorBrush x:Key="Brush.RowSelectedInactive" Color="#FF27272A" />
    <SolidColorBrush x:Key="Brush.SelectionText" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.TabSelected" Color="#FF27272A" />
    <SolidColorBrush x:Key="Brush.TabHover" Color="#FF232327" />
    <SolidColorBrush x:Key="Brush.InputSurface" Color="#FF232327" />
    <SolidColorBrush x:Key="Brush.InputBorder" Color="#FF3F3F46" />
    <SolidColorBrush x:Key="Brush.HeaderSurface" Color="#FF1E1E21" />
    <SolidColorBrush x:Key="Brush.ControlSurface" Color="#FF27272A" />
    <SolidColorBrush x:Key="Brush.ControlHover" Color="#FF303036" />
    <SolidColorBrush x:Key="Brush.ControlPressed" Color="#FF202024" />
    <SolidColorBrush x:Key="Brush.ControlDisabled" Color="#FF1E1E21" />
    <SolidColorBrush x:Key="Brush.ToolbarSurface" Color="#FF17171A" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#FF2A2A2F" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#FF3A3A42" />
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#FF56565F" />
    <SolidColorBrush x:Key="Brush.AccentFill" Color="#FF2563EB" />
    <SolidColorBrush x:Key="Brush.AccentFillHover" Color="#FF1D4ED8" />
    <SolidColorBrush x:Key="Brush.AccentFillPressed" Color="#FF1E40AF" />
</ResourceDictionary>
