<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light counterpart of the graphite palette: paper-white surfaces, system-blue accent.
         TextMuted and Warning were lifted to clear WCAG AA (4.5:1) on panel surfaces. -->
    <SolidColorBrush x:Key="Brush.ShellSurface" Color="#FFF3F3F5" />
    <SolidColorBrush x:Key="Brush.PanelSurface" Color="#FFFAFAFB" />
    <SolidColorBrush x:Key="Brush.PanelRaised" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.PanelBorder" Color="#FFDCDCE1" />
    <SolidColorBrush x:Key="Brush.PanelBorderStrong" Color="#FFC7C7CD" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FF1C1C1E" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FF4A4A50" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#FF6B6B75" />
    <SolidColorBrush x:Key="Brush.LogSurface" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.LogText" Color="#FF1C1C1E" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF1D4ED8" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#1A007AFF" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FF0066D6" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FF0055B3" />
    <SolidColorBrush x:Key="Brush.FocusStroke" Color="#FF1D4ED8" />
    <SolidColorBrush x:Key="Brush.Success" Color="#FF0F7B3F" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FF8A5A00" />
    <SolidColorBrush x:Key="Brush.SearchMatchBackground" Color="#FFFFD84D" />
    <SolidColorBrush x:Key="Brush.SearchMatchForeground" Color="#FF111114" />
    <SolidColorBrush x:Key="Brush.Caution" Color="#FF7A4F00" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FFC0271E" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#1A0F7B3F" />
    <SolidColorBrush x:Key="Brush.CautionSoft" Color="#1A7A4F00" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#1AC0271E" />
    <SolidColorBrush x:Key="Brush.StatusIdle" Color="#FF8E8E96" />
    <SolidColorBrush x:Key="Brush.RowHover" Color="#FFF2F2F4" />
    <SolidColorBrush x:Key="Brush.RowSelected" Color="#FFE6E6EA" />
    <SolidColorBrush x:Key="Brush.RowSelectedInactive" Color="#FFECECEF" />
    <SolidColorBrush x:Key="Brush.SelectionText" Color="#FF111114" />
    <SolidColorBrush x:Key="Brush.TabSelected" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.TabHover" Color="#FFF4F4F6" />
    <SolidColorBrush x:Key="Brush.InputSurface" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.InputBorder" Color="#FFD4D4D8" />
    <SolidColorBrush x:Key="Brush.HeaderSurface" Color="#FFF4F4F6" />
    <SolidColorBrush x:Key="Brush.ControlSurface" Color="#FFF4F4F6" />
    <SolidColorBrush x:Key="Brush.ControlHover" Color="#FFEFEFF2" />
    <SolidColorBrush x:Key="Brush.ControlPressed" Color="#FFE8E8EC" />
    <SolidColorBrush x:Key="Brush.ControlDisabled" Color="#FFF4F4F6" />
    <SolidColorBrush x:Key="Brush.ToolbarSurface" Color="#FFF2F2F4" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#FFE5E5E8" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#1F000000" />
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#40000000" />
    <SolidColorBrush x:Key="Brush.AccentFill" Color="#FF2563EB" />
    <SolidColorBrush x:Key="Brush.AccentFillHover" Color="#FF1D4ED8" />
    <SolidColorBrush x:Key="Brush.AccentFillPressed" Color="#FF1E40AF" />
</ResourceDictionary>
