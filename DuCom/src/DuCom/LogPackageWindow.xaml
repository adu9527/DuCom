<ui:FluentWindow x:Class="DuCom.LogPackageWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="{DynamicResource LogPackage.Title}"
                  Width="1080" Height="900" MinWidth="760" MinHeight="620"
                  Icon="/Assets/DuCom.ico"
                  ExtendsContentIntoTitleBar="True" ResizeMode="CanResize"
                  WindowBackdropType="Mica" WindowStartupLocation="Manual"
                  Closing="Window_Closing">
    <Grid Background="{DynamicResource Brush.ShellSurface}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ui:TitleBar Title="{DynamicResource LogPackage.Title}" ShowMaximize="True" ShowMinimize="True" />
        <ScrollViewer Grid.Row="1" Margin="24,16,24,12" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="960" HorizontalAlignment="Center">
                <!-- 基本信息 + 问题信息：双栏卡片 -->
                <Border Style="{DynamicResource Style.SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                        <!-- 左栏：基本信息 -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{DynamicResource Style.SectionTitle}" Text="{DynamicResource LogPackage.BasicInfo}" Margin="0,0,0,16" />

                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Width="90" VerticalAlignment="Center" Style="{DynamicResource Style.FieldLabel}" Text="{DynamicResource LogPackage.CurrentTime}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Margin="12,0,0,0" FontFamily="Consolas" IsReadOnly="True" Text="{Binding CurrentTime}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Width="90" Margin="0,14,0,0" VerticalAlignment="Center" Style="{DynamicResource Style.FieldLabel}" Text="{DynamicResource LogPackage.Project}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="12,14,0,0" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Width="90" Margin="0,14,0,0" VerticalAlignment="Center" Style="{DynamicResource Style.FieldLabel}" Text="{DynamicResource LogPackage.Tester}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="12,14,0,0" Text="{Binding Tester, UpdateSourceTrigger=PropertyChanged}" />

                                <!-- 设备版本 + 复现概率：同一行内并排 -->
                                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{DynamicResource Style.FieldLabel}" Text="{DynamicResource LogPackage.DeviceSoftwareVersion}" />
                                        <TextBox Width="160" Text="{Binding DeviceSoftwareVersion, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="24,0,0,0">
                                        <TextBlock Style="{DynamicResource Style.FieldLabel}" Text="{DynamicResource LogPackage.ReproductionProbability}" />
                                        <TextBox Width="100" Text="{Binding ReproductionProbability, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- 右栏：问题信息 -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{DynamicResource Style.SectionTitle}" Text="{DynamicResource LogPackage.ReproductionInfo}" Margin="0,0,0,16" />

                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Width="70" VerticalAlignment="Center" Style="{DynamicResource Style.FieldLabel}" Text="{DynamicResource LogPackage.ReproductionTime}" />
                                <Grid Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox FontFamily="Consolas" Text="{Binding ReproductionTime, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Margin="10,0,0,0" Padding="14,6" Command="{Binding CopyCurrentTimeCommand}" Content="{DynamicResource LogPackage.CopyTime}" />
                                </Grid>

                                <TextBlock Grid.Row="1" Grid.Column="0" Width="70" Margin="0,14,0,0" VerticalAlignment="Center" Style="{DynamicResource Style.FieldLabel}" Text="{DynamicResource LogPackage.ProblemTitle}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="12,14,0,0" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Width="70" Margin="0,14,0,0" VerticalAlignment="Top" Style="{DynamicResource Style.FieldLabel}" Text="{DynamicResource LogPackage.OutputDirectory}" />
                                <Grid Grid.Row="2" Grid.Column="1" Margin="12,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                    <Button Grid.Column="1" Margin="10,0,0,0" Padding="14,6" Command="{Binding SelectOutputDirectoryCommand}" Content="{DynamicResource LogPackage.Browse}" />
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 选择日志窗口 -->
                <Border Style="{DynamicResource Style.SettingsCard}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource Style.SectionTitle}" Text="{DynamicResource LogPackage.LogSelection}" Margin="0,0,0,8" />
                        <TextBlock Style="{DynamicResource Style.MutedText}" Text="{DynamicResource LogPackage.LogSelectionHint}" TextWrapping="Wrap" />
                        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Ports}">
                            <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="{Binding PortName}" />
                                <TextBox Grid.Column="1" Margin="12,0,0,0" IsEnabled="{Binding IsSelected}" Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource LogPackage.DeviceNameHint}" />
                            </Grid></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 问题描述 -->
                <Border Style="{DynamicResource Style.SettingsCard}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource Style.SectionTitle}" Text="{DynamicResource LogPackage.Description}" Margin="0,0,0,14" />

                        <TextBlock Style="{DynamicResource Style.FieldLabel}" Text="{DynamicResource LogPackage.ProblemDescription}" />
                        <TextBox Margin="0,6,0,0" MinHeight="120" AcceptsReturn="True" Text="{Binding ProblemDescription, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                        <TextBlock Margin="0,16,0,0" Style="{DynamicResource Style.FieldLabel}" Text="{DynamicResource LogPackage.ReproductionSteps}" />
                        <TextBox Margin="0,6,0,0" MinHeight="120" AcceptsReturn="True" Text="{Binding ReproductionSteps, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                        <TextBlock Margin="0,16,0,0" Style="{DynamicResource Style.FieldLabel}" Text="{DynamicResource LogPackage.Notes}" />
                        <TextBox Margin="0,6,0,0" MinHeight="72" AcceptsReturn="True" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Padding="16,10" Background="{DynamicResource Brush.PanelRaised}" BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="0,1,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Style="{DynamicResource Style.MutedText}" Text="{Binding Status}" TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button MinWidth="96" Click="Cancel_Click" Content="{DynamicResource LogPackage.Cancel}" />
                    <ui:Button MinWidth="120" Margin="10,0,0,0" Appearance="Primary" Command="{Binding CreatePackageCommand}" Content="{DynamicResource LogPackage.Create}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
