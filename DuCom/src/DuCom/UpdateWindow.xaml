<ui:FluentWindow x:Class="DuCom.UpdateWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource Update.Title}"
                 Width="560"
                 Height="520"
                 MinWidth="560"
                 MinHeight="440"
                 Icon="/Assets/DuCom.ico"
                 ExtendsContentIntoTitleBar="True"
                 ResizeMode="NoResize"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="{DynamicResource Update.Title}" ShowMaximize="False" ShowMinimize="False" />
        <Grid Grid.Row="2" Margin="28,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Padding="20" Style="{DynamicResource Style.SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{DynamicResource Style.MutedText}" Text="{DynamicResource Update.CurrentVersion}" />
                    <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="{Binding CurrentVersion}" />
                    <TextBlock Grid.Row="2" Style="{DynamicResource Style.MutedText}" Text="{DynamicResource Update.LatestVersion}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding LatestVersion}" />
                    <TextBlock Grid.Row="4" Style="{DynamicResource Style.MutedText}" Text="{DynamicResource Update.Channel}" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding ChannelText}" />
                </Grid>
            </Border>
            <Border Grid.Row="2" Padding="20" Style="{DynamicResource Style.SettingsCard}" Visibility="{Binding HasReleaseNotes, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Style.SectionTitle}" Text="{DynamicResource Update.ReleaseNotes}" />
                    <TextBox MaxHeight="170"
                             Margin="0,10,0,0"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono, Consolas"
                             IsReadOnly="True"
                             Text="{Binding ReleaseNotes, Mode=OneWay}"
                             TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Row="4" Padding="20" Style="{DynamicResource Style.SettingsCard}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Style.SectionTitle}" Text="{DynamicResource Update.Status}" />
                    <ProgressBar Height="6"
                                 Margin="0,12,0,0"
                                 IsIndeterminate="{Binding IsIndeterminate}"
                                 Maximum="100"
                                 Minimum="0"
                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                 Visibility="{Binding IsProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Margin="0,10,0,0"
                               Style="{DynamicResource Style.MutedText}"
                               Text="{Binding StatusText}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="6" Orientation="Horizontal">
                <Button MinWidth="96"
                        Command="{Binding CheckCommand}"
                        Content="{DynamicResource Update.Check}"
                        IsEnabled="{Binding CanCheck}" />
                <Button MinWidth="96"
                        Margin="12,0,0,0"
                        Command="{Binding DownloadCommand}"
                        Content="{DynamicResource Update.Download}"
                        IsEnabled="{Binding CanDownload}" />
                <ui:Button MinWidth="96"
                           Margin="12,0,0,0"
                           Appearance="Primary"
                           Command="{Binding ApplyAndRestartCommand}"
                           Content="{DynamicResource Update.ApplyAndRestart}"
                           IsEnabled="{Binding CanApply}" />
                <Button MinWidth="96"
                        Margin="12,0,0,0"
                        Command="{Binding SkipVersionCommand}"
                        Content="{DynamicResource Update.SkipVersion}"
                        IsEnabled="{Binding CanSkip}" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="3"
                    Margin="28,16,28,24"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Style="{DynamicResource Style.MutedText}">
                <Hyperlink Click="ReleasePage_Click" NavigateUri="{Binding ReleasePageUrl, Mode=OneWay}">
                    <Run Text="{DynamicResource Update.OpenReleasePage}" />
                </Hyperlink>
            </TextBlock>
            <Button MinWidth="96"
                    Margin="20,0,0,0"
                    Click="Close_Click"
                    Content="{DynamicResource Update.Close}" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
