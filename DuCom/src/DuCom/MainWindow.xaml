<ui:FluentWindow x:Class="DuCom.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:local="clr-namespace:DuCom"
                  xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                 xmlns:behaviors="clr-namespace:DuCom.Behaviors"
                 xmlns:converters="clr-namespace:DuCom.Converters"
                  xmlns:sending="clr-namespace:DuCom.Core.Sending;assembly=DuCom.Core"
                  xmlns:viewModels="clr-namespace:DuCom.ViewModels"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource App.Title}"
                 Width="1280"
                  Height="800"
                  Icon="/Assets/DuCom.ico"
                  MinWidth="960"
                 MinHeight="640"
                  ExtendsContentIntoTitleBar="True"
                 PreviewKeyDown="Window_PreviewKeyDown"
                 ResizeMode="CanResize"
                  WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen"
                 mc:Ignorable="d">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:EqualityConverter x:Key="EqualityConverter" />
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource Brush.ShellSurface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Image Grid.RowSpan="2"
               IsHitTestVisible="False"
               Opacity="{Binding BackgroundImageOpacity}"
               Panel.ZIndex="100"
               Source="{Binding BackgroundImageSource}"
               Stretch="UniformToFill">
            <Image.Style>
                <Style TargetType="Image">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BackgroundImageEnabled}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Image.Style>
        </Image>

        <ui:TitleBar Grid.Row="0"
                     Panel.ZIndex="101"
                     ShowMaximize="True"
                     ShowMinimize="True">
            <ui:TitleBar.Header>
            <StackPanel Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Orientation="Horizontal">
                <Button x:Name="FileMenuButton"
                        Style="{StaticResource Style.TopNavButton}"
                        Click="TopMenuButton_Click"
                        Content="{DynamicResource Menu.File}">
                    <Button.ContextMenu>
                        <ContextMenu Placement="Bottom">
                            <MenuItem Command="{Binding OpenLogFileCommand}" Header="{DynamicResource Menu.File.OpenLog}" />
                            <MenuItem Header="{DynamicResource Menu.File.SaveLogAs}">
                                <MenuItem Command="{Binding SaveVisibleLogCommand}" Header="{DynamicResource Menu.File.SaveAsText}" />
                                <MenuItem Command="{Binding SaveVisibleLogAsHexCommand}" Header="{DynamicResource Menu.File.SaveAsHex}" />
                                <MenuItem Command="{Binding SaveVisibleLogAsBinaryCommand}" Header="{DynamicResource Menu.File.SaveAsBinary}" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Command="{Binding ImportConfigurationCommand}" Header="{DynamicResource Menu.File.ImportConfig}" />
                            <MenuItem Command="{Binding ExportConfigurationCommand}" Header="{DynamicResource Menu.File.ExportConfig}" />
                            <Separator />
                            <MenuItem Command="{Binding OpenLogFolderCommand}" Header="{DynamicResource Log.OpenFolder}" />
                            <MenuItem Command="{Binding OpenApplicationFolderCommand}" Header="{DynamicResource Menu.File.AppFolder}" />
                            <MenuItem Command="{Binding ExitApplicationCommand}" Header="{DynamicResource Menu.File.Exit}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="ViewMenuButton"
                         Style="{StaticResource Style.TopNavButton}"
                         Click="TopMenuButton_Click"
                         Content="{DynamicResource Menu.View}">
                    <Button.ContextMenu>
                        <ContextMenu Placement="Bottom">
                            <MenuItem Command="{Binding ToggleFollowEndCommand}"
                                      Header="{DynamicResource Log.Follow}"
                                      IsCheckable="True"
                                      IsChecked="{Binding SelectedSession.FollowEnd, Mode=OneWay}" />
                             <MenuItem Command="{Binding ToggleFloatSendCommand}" Header="{DynamicResource Menu.View.FloatSend}" />
                             <MenuItem Command="{Binding ToggleBottomSendCommand}"
                                       Header="{DynamicResource Menu.View.BottomSend}"
                                       IsCheckable="True"
                                       IsChecked="{Binding IsBottomSendVisible, Mode=OneWay}" />
                             <Separator />
                            <MenuItem Command="{Binding ToggleSidebarCommand}"
                                      Header="{DynamicResource Menu.Tools.Sidebar}"
                                      IsCheckable="True"
                                      IsChecked="{Binding IsSidebarVisible, Mode=OneWay}" />
                            <MenuItem Header="{DynamicResource Menu.Edit.ViewOptions}">
                                <MenuItem Header="{DynamicResource Menu.Edit.WordWrap}" IsCheckable="True" IsChecked="{Binding WordWrap}" />
                                <MenuItem Header="{DynamicResource Menu.Edit.LineNumbers}" IsCheckable="True" IsChecked="{Binding ShowLineNumbers}" />
                                <MenuItem Header="{DynamicResource Menu.Edit.HighlightCurrentLine}" IsCheckable="True" IsChecked="{Binding HighlightCurrentLine}" />
                                <MenuItem Header="{DynamicResource Menu.Edit.ShowControlChars}" IsCheckable="True" IsChecked="{Binding ShowControlCharacters}" />
                                <MenuItem Header="{DynamicResource Menu.Edit.ShowSpaces}" IsCheckable="True" IsChecked="{Binding ShowSpaces}" />
                                <MenuItem Header="{DynamicResource Menu.Edit.ShowTabs}" IsCheckable="True" IsChecked="{Binding ShowTabs}" />
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Menu.Edit.FontSize}">
                                <MenuItem Header="12" IsCheckable="True" IsChecked="{Binding LogFontSize, Converter={StaticResource EqualityConverter}, ConverterParameter=12}" Click="FontSizeMenu_Click" Tag="12" />
                                <MenuItem Header="13" IsCheckable="True" IsChecked="{Binding LogFontSize, Converter={StaticResource EqualityConverter}, ConverterParameter=13}" Click="FontSizeMenu_Click" Tag="13" />
                                <MenuItem Header="14" IsCheckable="True" IsChecked="{Binding LogFontSize, Converter={StaticResource EqualityConverter}, ConverterParameter=14}" Click="FontSizeMenu_Click" Tag="14" />
                                <MenuItem Header="16" IsCheckable="True" IsChecked="{Binding LogFontSize, Converter={StaticResource EqualityConverter}, ConverterParameter=16}" Click="FontSizeMenu_Click" Tag="16" />
                                <MenuItem Header="18" IsCheckable="True" IsChecked="{Binding LogFontSize, Converter={StaticResource EqualityConverter}, ConverterParameter=18}" Click="FontSizeMenu_Click" Tag="18" />
                                 <MenuItem Header="20" IsCheckable="True" IsChecked="{Binding LogFontSize, Converter={StaticResource EqualityConverter}, ConverterParameter=20}" Click="FontSizeMenu_Click" Tag="20" />
                             </MenuItem>
                            <Separator />
                                <MenuItem Header="{DynamicResource Menu.Tools.Theme}">
                                    <MenuItem Command="{Binding ApplyLightThemeCommand}" Header="{DynamicResource Menu.Tools.Theme.Light}" IsCheckable="True" IsChecked="{Binding IsLightTheme, Mode=OneWay}" />
                                    <MenuItem Command="{Binding ApplyDarkThemeCommand}" Header="{DynamicResource Menu.Tools.Theme.Dark}" IsCheckable="True" IsChecked="{Binding IsDarkTheme, Mode=OneWay}" />
                                </MenuItem>
                            <MenuItem Header="{DynamicResource Settings.Language}">
                                <MenuItem Command="{Binding ApplyChineseLanguageCommand}" Header="简体中文" IsCheckable="True" IsChecked="{Binding IsChineseLanguage, Mode=OneWay}" />
                                <MenuItem Command="{Binding ApplyEnglishLanguageCommand}" Header="English" IsCheckable="True" IsChecked="{Binding IsEnglishLanguage, Mode=OneWay}" />
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="ToolsMenuButton"
                        Style="{StaticResource Style.TopNavButton}"
                        Click="TopMenuButton_Click"
                        Content="{DynamicResource Menu.Tools}">
                    <Button.ContextMenu>
                        <ContextMenu Placement="Bottom">
                            <MenuItem Command="{Binding ToggleSettingsCommand}" Header="{DynamicResource Settings.Title}" />
                            <MenuItem Command="{Binding ShowHighlightFilterRulesCommand}" Header="{DynamicResource Menu.Tools.HighlightFilter}" />
                            <MenuItem Command="{Binding ShowLogFilterCommand}" Header="{DynamicResource Menu.Tools.LogFilter}" />
                            <MenuItem Command="{Binding ShowCommandGroupsCommand}" Header="{DynamicResource Menu.Tools.Commands}" />
                            <MenuItem Command="{Binding ShowToolCenterCommand}" CommandParameter="send-history" Header="{DynamicResource Menu.Tools.SendHistory}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="AboutMenuButton"
                         Style="{StaticResource Style.TopNavButton}"
                         Click="TopMenuButton_Click"
                         Content="{DynamicResource Menu.About}">
                    <Button.ContextMenu>
                        <ContextMenu Placement="Bottom">
                            <MenuItem Command="{Binding OpenDocumentationCommand}" Header="{DynamicResource Menu.About.Help}" />
                            <MenuItem Command="{Binding OpenFeedbackCommand}" Header="{DynamicResource Menu.About.Feedback}" />
                            <Separator />
                            <MenuItem Command="{Binding CheckForUpdatesCommand}" Header="{DynamicResource Settings.CheckForUpdates}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon FontSize="16" Symbol="ArrowSync24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="{Binding ShowAboutCommand}" Header="{DynamicResource About.Title}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Margin="6,0,0,0"
                        Style="{StaticResource Style.TopNavButton}"
                        Command="{Binding ShowLogPackageCommand}"
                        Content="{DynamicResource LogPackage.Entry}"
                        ToolTip="{DynamicResource LogPackage.EntryHint}"
                        Visibility="{Binding LogPackagePluginEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <StackPanel Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Orientation="Horizontal"
                            Visibility="{Binding ShowMemoryMonitor, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Padding="8,4"
                            Background="{DynamicResource Brush.PanelRaised}"
                            BorderBrush="{DynamicResource Brush.PanelBorder}"
                            BorderThickness="2"
                            CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding ElementName=ProcessMemoryTooltip, Path=Text}">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="#1D9E75" />
                                <TextBlock x:Name="ProcessMemoryText"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           Text="-- MB" />
                                <TextBlock x:Name="ProcessMemoryTooltip" Visibility="Collapsed" />
                            </StackPanel>
                            <Border Width="2"
                                    Height="12"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.PanelBorder}" />
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding ElementName=SystemMemoryTooltip, Path=Text}">
                                <Ellipse x:Name="SystemMemoryDot"
                                         Width="6"
                                         Height="6"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource Brush.Success}" />
                                <TextBlock x:Name="SystemMemoryText"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource Brush.Success}"
                                           Text="--%" />
                                <TextBlock x:Name="SystemMemoryTooltip" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="6,0,6,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ConnectionColumn">
                    <ColumnDefinition.Style>
                        <Style BasedOn="{StaticResource Style.ConnectionColumn}" TargetType="ColumnDefinition">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarVisible}" Value="False">
                                    <Setter Property="Width" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                 <ColumnDefinition x:Name="ConnectionSplitterColumn">
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                             <Setter Property="Width" Value="4" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarVisible}" Value="False">
                                    <Setter Property="Width" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource Style.Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Height="32"
                            Margin="-8,-8,-8,0"
                            Padding="2,2,4,2"
                            Background="{DynamicResource Brush.PanelRaised}"
                            BorderBrush="{DynamicResource Brush.PanelBorder}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Width="28"
                                Height="28"
                                Padding="0"
                                Command="{Binding RefreshPortsCommand}"
                                Style="{StaticResource Style.ToolbarIconButton}"
                                ToolTip="{DynamicResource Connection.Refresh}"
                                AutomationProperties.Name="{DynamicResource Connection.Refresh}">
                            <ui:SymbolIcon FontSize="15" Symbol="ArrowClockwise24" />
                        </Button>
                        <Button x:Name="PortViewButton"
                                Grid.Column="2"
                                MinWidth="48"
                                Height="28"
                                Padding="8,0"
                                Click="ToolbarMenuButton_Click"
                                Content="{DynamicResource Connection.ViewButton}"
                                FontSize="12"
                                Style="{StaticResource Style.ToolbarButton}"
                                ToolTip="{DynamicResource Connection.ShowHidden}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                     <MenuItem Command="{Binding ShowVisiblePortsCommand}" Header="{DynamicResource Connection.VisibleOnly}" />
                                     <MenuItem Command="{Binding ShowAllPortsCommand}" Header="{DynamicResource Connection.ShowAll}" />
                                     <Separator />
                                     <MenuItem Header="{DynamicResource Connection.ShowSerialPorts}"
                                               IsCheckable="True"
                                               IsChecked="{Binding ShowSerialPorts}"
                                               StaysOpenOnClick="True" />
                                     <MenuItem Header="{DynamicResource Connection.ShowVirtualPorts}"
                                               IsCheckable="True"
                                               IsChecked="{Binding ShowVirtualPorts}"
                                               StaysOpenOnClick="True" />
                                     <Separator />
                                     <MenuItem Command="{Binding RestoreAllHiddenPortsCommand}" Header="{DynamicResource Connection.RestoreHidden}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="PortSortButton"
                                Grid.Column="4"
                                MinWidth="48"
                                Height="28"
                                Padding="8,0"
                                Click="ToolbarMenuButton_Click"
                                Content="{DynamicResource Connection.SortButton}"
                                FontSize="12"
                                Style="{StaticResource Style.ToolbarButton}"
                                ToolTip="{DynamicResource Connection.Sort}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="{Binding SetPortSortCommand}" CommandParameter="NameAscending" Header="{DynamicResource Connection.SortAscending}" />
                                    <MenuItem Command="{Binding SetPortSortCommand}" CommandParameter="NameDescending" Header="{DynamicResource Connection.SortDescending}" />
                                    <MenuItem Command="{Binding SetPortSortCommand}" CommandParameter="ConnectedFirst" Header="{DynamicResource Connection.SortConnected}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Grid.Column="6"
                                Width="28"
                                Height="28"
                                Padding="0"
                                Command="{Binding ToggleSidebarCommand}"
                                Style="{StaticResource Style.ToolbarIconButton}"
                                ToolTip="{DynamicResource Connection.CloseSidebar}"
                                AutomationProperties.Name="{DynamicResource Connection.CloseSidebar}">
                            <ui:SymbolIcon FontSize="15" Symbol="ChevronLeft24" />
                        </Button>
                    </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{DynamicResource Connection.NoPorts}">
                            <TextBlock.Style>
                                <Style BasedOn="{StaticResource Style.MutedText}" TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AvailablePorts.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ListBox Background="Transparent"
                                 PreviewMouseLeftButtonDown="DragSource_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="PortList_PreviewMouseMove"
                                  BorderThickness="0"
                                 ItemsSource="{Binding AvailablePorts}"
                                  SelectedItem="{Binding SelectedPortItem}"
                                  Padding="0,4,0,0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                         <ListBox.ItemContainerStyle>
                             <Style TargetType="ListBoxItem" BasedOn="{StaticResource Style.PortListItem}">
                                     <Setter Property="MinHeight" Value="44" />
                                     <Setter Property="Margin" Value="0,1" />
                                     <Setter Property="Padding" Value="8,6" />
                                    <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                        <Setter Property="Opacity" Value="0.55" />
                                    </DataTrigger>
                                     <DataTrigger Binding="{Binding DataContext.ShowPortType, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                         <Setter Property="MinHeight" Value="36" />
                                         <Setter Property="Padding" Value="8,4" />
                                     </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Command="{Binding ToggleHiddenCommand}"
                                                          Header="{DynamicResource Connection.HidePort}" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.ToolTip>
                                            <Border Background="{DynamicResource Brush.PanelRaised}"
                                                    BorderBrush="{DynamicResource Brush.PanelBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="12,10">
                                                <StackPanel>
                                                    <TextBlock Margin="0,0,0,8"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               Text="{Binding PortName}" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="14" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Style="{StaticResource Style.PortDetailLabel}" Text="{DynamicResource Port.Detail.DeviceName}" />
                                                        <TextBlock Grid.Column="2" Style="{StaticResource Style.PortDetailValue}" Text="{Binding DisplayDeviceName}" />
                                                        <TextBlock Grid.Row="1" Style="{StaticResource Style.PortDetailLabel}" Text="{DynamicResource Port.Detail.Manufacturer}" />
                                                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Style.PortDetailValue}" Text="{Binding DisplayManufacturer}" />
                                                        <TextBlock Grid.Row="2" Style="{StaticResource Style.PortDetailLabel}" Text="{DynamicResource Port.Detail.VidPid}" />
                                                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Style.PortDetailValue}" Text="{Binding DisplayVidPid}" />
                                                        <TextBlock Grid.Row="3" Style="{StaticResource Style.PortDetailLabel}" Text="{DynamicResource Port.Detail.SerialNumber}" />
                                                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Style.PortDetailValue}" Text="{Binding DisplaySerialNumber}" />
                                                        <TextBlock Grid.Row="4" Style="{StaticResource Style.PortDetailLabel}" Text="{DynamicResource Port.Detail.DeviceInstanceId}" />
                                                        <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Style.PortDetailValue}" Text="{Binding DisplayDeviceInstanceId}" />
                                                        <TextBlock Grid.Row="5" Style="{StaticResource Style.PortDetailLabel}" Text="{DynamicResource Port.Detail.LocationInfo}" />
                                                        <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource Style.PortDetailValue}" Text="{Binding DisplayLocationInfo}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Grid.ToolTip>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Status dot -->
                                        <Ellipse Width="9"
                                                 Height="9"
                                                 VerticalAlignment="Center"
                                                 StrokeThickness="0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                     <Setter Property="Fill" Value="{DynamicResource Brush.StatusIdle}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="Open">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Opening">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Caution}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Closing">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Caution}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasFault}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <!-- Port name + type chip + device details -->
                                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="13"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding PortName}" />
                                                <Border Margin="7,0,0,0"
                                                        Padding="5,1"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="3"
                                                        Visibility="{Binding DataContext.ShowPortType, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.RowHover}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PortType}" Value="USB">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PortType}" Value="VAR">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.CautionSoft}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding PortType}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PortType}" Value="USB">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding PortType}" Value="VAR">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Caution}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DeviceName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DeviceName}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Setter Property="Margin" Value="0,3,0,0" />
                                                        <Setter Property="FontSize" Value="11" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.ShowPortType, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                         </StackPanel>

                                        <!-- Connect / disconnect: always visible so selection never shifts the row -->
                                        <Button Grid.Column="2"
                                                Style="{StaticResource Style.ToolbarIconButton}"
                                                Command="{Binding ToggleConnectionCommand}">
                                            <Button.ToolTip>
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{DynamicResource Connection.Open}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                                    <Setter Property="Text" Value="{DynamicResource Connection.Close}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button.ToolTip>
                                            <ui:SymbolIcon FontSize="15" Symbol="PlugConnected24">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="PlugConnected24" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                                <Setter Property="Symbol" Value="PlugDisconnected24" />
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <Button x:Name="DuComMenuButton"
                            Grid.Row="2"
                             Height="34"
                             Margin="-8,4,-8,-8"
                             Padding="12,0"
                             HorizontalContentAlignment="Stretch"
                            Click="DuComMenu_Click"
                            Style="{StaticResource Style.DuComMenuButton}">
                        <Button.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           Text="DuCom" />
                                <ui:SymbolIcon Grid.Column="1"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="16"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               Symbol="MoreHorizontal24" />
                            </Grid>
                        </Button.Content>
                        <Button.ContextMenu>
                            <ContextMenu Placement="Top" VerticalOffset="-4">
                                <MenuItem Header="{DynamicResource Menu.Tools.Theme}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon FontSize="16" Symbol="Color24" />
                                    </MenuItem.Icon>
                                    <MenuItem Command="{Binding ApplyLightThemeCommand}"
                                              Header="{DynamicResource Menu.Tools.Theme.Light}"
                                              IsCheckable="True"
                                              IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                                              StaysOpenOnClick="True" />
                                    <MenuItem Command="{Binding ApplyDarkThemeCommand}"
                                              Header="{DynamicResource Menu.Tools.Theme.Dark}"
                                              IsCheckable="True"
                                              IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                                              StaysOpenOnClick="True" />
                                </MenuItem>
                                <MenuItem Command="{Binding ToggleSettingsCommand}" Header="{DynamicResource Settings.MenuTitle}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon FontSize="16" Symbol="Settings24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Command="{Binding CheckForUpdatesCommand}" Header="{DynamicResource Settings.CheckForUpdates}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon FontSize="16" Symbol="ArrowSync24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Command="{Binding OpenFeedbackCommand}"
                                          Header="{DynamicResource Menu.About.Feedback}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon FontSize="16" Symbol="QuestionCircle24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns">
                <GridSplitter.Style>
                    <Style BasedOn="{StaticResource Style.Splitter}" TargetType="GridSplitter">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarVisible}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </GridSplitter.Style>
            </GridSplitter>

            <Border x:Name="LogWorkspace"
                    Grid.Column="2"
                    AllowDrop="True"
                    DragLeave="LogWorkspace_DragLeave"
                    DragOver="LogWorkspace_DragOver"
                    Drop="LogWorkspace_Drop"
                    Style="{DynamicResource Style.Panel}">
                <Grid>
                    <Grid x:Name="SessionWorkspaceContent">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSessions}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition>
                                <ColumnDefinition.Style>
                                    <Style TargetType="ColumnDefinition">
                                        <Setter Property="Width" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSplitView}" Value="True">
                                                <Setter Property="Width" Value="6" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ColumnDefinition.Style>
                            </ColumnDefinition>
                            <ColumnDefinition>
                                <ColumnDefinition.Style>
                                    <Style TargetType="ColumnDefinition">
                                        <Setter Property="Width" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSplitView}" Value="True">
                                                <Setter Property="Width" Value="*" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ColumnDefinition.Style>
                            </ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="MainSessionTabs"
                                  AllowDrop="True"
                                  Drop="SessionTabs_Drop"
                                  PreviewMouseLeftButtonDown="DragSource_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="SessionTabs_PreviewMouseMove"
                                 ItemsSource="{Binding Sessions}"
                                 SelectedItem="{Binding SelectedSession}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                             <ListBox.ItemContainerStyle>
                                  <Style TargetType="ListBoxItem" BasedOn="{StaticResource Style.SessionTabListItem}">
                                     <Setter Property="Visibility" Value="Visible" />
                                     <Style.Triggers>
                                         <DataTrigger Binding="{Binding IsInRightPane}" Value="True">
                                             <Setter Property="Visibility" Value="Collapsed" />
                                         </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                             <ListBox.ItemTemplate>
                                 <DataTemplate>
                                     <Grid>
                                         <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="Auto" />
                                             <ColumnDefinition Width="Auto" />
                                             <ColumnDefinition Width="Auto" />
                                         </Grid.ColumnDefinitions>
                                         <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                             <Ellipse.Style>
                                                 <Style TargetType="Ellipse">
                                                     <Setter Property="Fill" Value="{DynamicResource Brush.StatusIdle}" />
                                                     <Style.Triggers>
                                                         <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                             <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                                         </DataTrigger>
                                                         <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                             <Setter Property="Fill" Value="{DynamicResource Brush.Caution}" />
                                                         </DataTrigger>
                                                         <DataTrigger Binding="{Binding HasFault}" Value="True">
                                                             <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                                         </DataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </Ellipse.Style>
                                         </Ellipse>
                                         <TextBlock Grid.Column="1"
                                                    Margin="0"
                                                    MinWidth="42"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding PortName}"
                                                    TextTrimming="CharacterEllipsis" />
                                          <Button Grid.Column="2"
                                                  Command="{Binding DataContext.CloseSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}"
                                                   Style="{StaticResource Style.SessionCloseButton}"
                                                  ToolTip="{DynamicResource Shortcut.CloseSelectedSession}"
                                                  AutomationProperties.Name="{DynamicResource Shortcut.CloseSelectedSession}">
                                            <ui:SymbolIcon FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Symbol="Dismiss24" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ListBox x:Name="RightSessionTabs"
                                  Grid.Column="2"
                                  AllowDrop="True"
                                  Drop="SessionTabs_Drop"
                                 PreviewMouseLeftButtonDown="DragSource_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="SessionTabs_PreviewMouseMove"
                                 ItemsSource="{Binding RightSessions}"
                                 SelectedItem="{Binding SelectedRightSession}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 Visibility="{Binding IsSplitView, Converter={StaticResource BooleanToVisibilityConverter}}">
                             <ListBox.ItemContainerStyle>
                                 <Style TargetType="ListBoxItem" BasedOn="{StaticResource Style.SessionTabListItem}" />
                             </ListBox.ItemContainerStyle>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                             <ListBox.ItemTemplate>
                                 <DataTemplate>
                                     <Grid>
                                        <Grid.ContextMenu>
                                             <ContextMenu>
                                                 <MenuItem Command="{Binding DataContext.MoveRightSessionToMainCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}"
                                                           Header="{DynamicResource Layout.MoveToMain}" />
                                                 <MenuItem Command="{Binding DataContext.CloseRightPaneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}"
                                                           Header="{DynamicResource Layout.CloseRightSession}" />
                                             </ContextMenu>
                                        </Grid.ContextMenu>
                                         <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="Auto" />
                                             <ColumnDefinition Width="Auto" />
                                             <ColumnDefinition Width="Auto" />
                                         </Grid.ColumnDefinitions>
                                         <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                             <Ellipse.Style>
                                                 <Style TargetType="Ellipse">
                                                     <Setter Property="Fill" Value="{DynamicResource Brush.StatusIdle}" />
                                                     <Style.Triggers>
                                                         <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                             <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                                         </DataTrigger>
                                                         <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                             <Setter Property="Fill" Value="{DynamicResource Brush.Caution}" />
                                                         </DataTrigger>
                                                         <DataTrigger Binding="{Binding HasFault}" Value="True">
                                                             <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                                         </DataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </Ellipse.Style>
                                         </Ellipse>
                                         <TextBlock Grid.Column="1"
                                                    Margin="0"
                                                    MinWidth="42"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding PortName}"
                                                    TextTrimming="CharacterEllipsis" />
                                          <Button Grid.Column="2"
                                                  Command="{Binding DataContext.CloseRightPaneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}"
                                                   Style="{StaticResource Style.SessionCloseButton}"
                                                   ToolTip="{DynamicResource Layout.CloseRightSession}"
                                                   AutomationProperties.Name="{DynamicResource Layout.CloseRightSession}">
                                            <ui:SymbolIcon FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Symbol="Dismiss24" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Grid x:Name="SplitWorkspaceGrid" Grid.Row="2" Loaded="SplitWorkspaceGrid_Loaded">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="PrimarySplitColumn" Width="*" />
                            <ColumnDefinition x:Name="SplitGapColumn" Width="4" />
                            <ColumnDefinition x:Name="SecondarySplitColumn" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="PrimarySplitRow" Height="*" />
                            <RowDefinition x:Name="SplitGapRow" Height="0" />
                            <RowDefinition x:Name="SecondarySplitRow" Height="0" />
                        </Grid.RowDefinitions>

                        <local:SessionWorkspace x:Name="LeftWorkspace" DataContext="{Binding SelectedSession}" />
                        <GridSplitter x:Name="SessionGridSplitter"
                                      Width="4"
                                      Height="4"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      DragCompleted="SessionGridSplitter_DragCompleted"
                                      Visibility="{Binding IsSplitView, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <GridSplitter.Style>
                                <Style BasedOn="{StaticResource Style.Splitter}" TargetType="GridSplitter">
                                    <Setter Property="Grid.Column" Value="1" />
                                    <Setter Property="ResizeDirection" Value="Columns" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SplitOrientation}" Value="{x:Static viewModels:SplitLayoutOrientation.Horizontal}">
                                            <Setter Property="ResizeDirection" Value="Rows" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </GridSplitter.Style>
                        </GridSplitter>
                        <local:SessionWorkspace x:Name="RightWorkspace"
                                                 DataContext="{Binding SelectedRightSession}"
                                                 Visibility="{Binding IsSplitView, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <local:SessionWorkspace.Style>
                                <Style TargetType="local:SessionWorkspace">
                                    <Setter Property="Grid.Column" Value="2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.SplitOrientation, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Static viewModels:SplitLayoutOrientation.Horizontal}">
                                            <Setter Property="Grid.Row" Value="2" />
                                            <Setter Property="Grid.Column" Value="0" />
                                            <Setter Property="Grid.ColumnSpan" Value="3" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </local:SessionWorkspace.Style>
                        </local:SessionWorkspace>
                    </Grid>

                    </Grid>

                    <Grid x:Name="CoverPageGrid"
                          ClipToBounds="True"
                          IsHitTestVisible="False"
                          Panel.ZIndex="20">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasSessions}" Value="False" />
                                            <Condition Binding="{Binding ShowCoverPage}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <!-- The backdrop fills and crops independently; foreground content always remains in the safe area. -->
                        <Viewbox HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 Stretch="UniformToFill"
                                 StretchDirection="Both">
                            <Canvas Width="800" Height="500">
                                <Rectangle Width="800" Height="500" Fill="#101217" />
                                <Rectangle Width="800" Height="500" Opacity="0.75">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#18202B" Offset="0" />
                                            <GradientStop Color="#101217" Offset="0.46" />
                                            <GradientStop Color="#0B1018" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <Path Data="M0,40 H800 M0,80 H800 M0,120 H800 M0,160 H800 M0,200 H800 M0,240 H800 M0,280 H800 M0,320 H800 M0,360 H800 M0,400 H800 M0,440 H800 M40,0 V500 M80,0 V500 M120,0 V500 M160,0 V500 M200,0 V500 M240,0 V500 M280,0 V500 M320,0 V500 M360,0 V500 M400,0 V500 M440,0 V500 M480,0 V500 M520,0 V500 M560,0 V500 M600,0 V500 M640,0 V500 M680,0 V500 M720,0 V500 M760,0 V500"
                                      Stroke="#223C52" StrokeThickness="1" Opacity="0.24" />
                                <Rectangle Width="800" Height="2" Canvas.Top="-8" Fill="#42A5F5">
                                    <Rectangle.Effect>
                                        <BlurEffect Radius="8" />
                                    </Rectangle.Effect>
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Opacity" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CoverPageAnimationEnabled}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="BackdropScanAnimation">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(Canvas.Top)"
                                                                                 From="-8" To="508" Duration="0:0:4.8"
                                                                                 RepeatBehavior="Forever" />
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 From="0.08" To="0.32" Duration="0:0:2.4"
                                                                                 AutoReverse="True" RepeatBehavior="Forever" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <RemoveStoryboard BeginStoryboardName="BackdropScanAnimation" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Canvas.Left="-40" Canvas.Top="112" Width="260" Height="260" Opacity="0.16">
                                    <Rectangle.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#1976D2" Offset="0" />
                                            <GradientStop Color="Transparent" Offset="1" />
                                        </RadialGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle Canvas.Left="580" Canvas.Top="62" Width="260" Height="260" Opacity="0.12">
                                    <Rectangle.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#26C6DA" Offset="0" />
                                            <GradientStop Color="Transparent" Offset="1" />
                                        </RadialGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Canvas>
                        </Viewbox>

                        <Viewbox HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Stretch="Uniform"
                                 StretchDirection="Both">
                            <Canvas Width="800" Height="500">

                                <!-- Pixel grid and corner framing. -->
                                <Path Data="M28,92 V48 H72 M28,48 H116 V56 H132 M772,408 V452 H728 M772,452 H684 V444 H668"
                                      Stroke="#3B82B5" StrokeThickness="4" StrokeStartLineCap="Square" StrokeEndLineCap="Square" Opacity="0.7" />
                                <Path Data="M28,112 H76 V104 H108 V120 H148 M772,388 H724 V396 H692 V380 H652"
                                      Stroke="#304A61" StrokeThickness="4" Opacity="0.65" />

                                <Canvas>
                                    <Canvas.Style>
                                        <Style TargetType="Canvas">
                                            <Setter Property="Opacity" Value="0.45" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CoverPageAnimationEnabled}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="PixelNodeAnimation">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 From="0.25" To="0.85"
                                                                                 BeginTime="0:0:0.4" Duration="0:0:2.2"
                                                                                 AutoReverse="True" RepeatBehavior="Forever" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <RemoveStoryboard BeginStoryboardName="PixelNodeAnimation" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Canvas.Style>
                                    <Rectangle Canvas.Left="68" Canvas.Top="44" Width="8" Height="8" Fill="#62C8FF" />
                                    <Rectangle Canvas.Left="128" Canvas.Top="52" Width="6" Height="6" Fill="#3B82B5" />
                                    <Rectangle Canvas.Left="720" Canvas.Top="86" Width="8" Height="8" Fill="#62C8FF" />
                                    <Rectangle Canvas.Left="750" Canvas.Top="112" Width="4" Height="4" Fill="#42759A" />
                                    <Rectangle Canvas.Left="88" Canvas.Top="406" Width="6" Height="6" Fill="#42759A" />
                                    <Rectangle Canvas.Left="704" Canvas.Top="438" Width="8" Height="8" Fill="#62C8FF" />
                                </Canvas>

                                <Border Canvas.Left="174" Canvas.Top="148" Width="452" Height="116"
                                        BorderBrush="#24516F" BorderThickness="2" CornerRadius="0" Opacity="0.72">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Opacity" Value="0.55" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CoverPageAnimationEnabled}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="TitleFrameAnimation">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 From="0.38" To="0.9" Duration="0:0:2"
                                                                                 AutoReverse="True" RepeatBehavior="Forever" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <RemoveStoryboard BeginStoryboardName="TitleFrameAnimation" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Rectangle Canvas.Left="166" Canvas.Top="140" Width="24" Height="6" Fill="#42A5F5" />
                                <Rectangle Canvas.Left="610" Canvas.Top="266" Width="24" Height="6" Fill="#42A5F5" />

                                <!-- Block title assembled from square pixel runs. -->
                                <Canvas Canvas.Left="203" Canvas.Top="179" Opacity="0.32">
                                    <Path Fill="#087AC1" Data="M0,0 H40 V10 H50 V60 H40 V70 H0 Z M10,10 V60 H35 V50 H40 V20 H35 V10 Z M68,0 H78 V55 H88 V60 H108 V55 H118 V0 H128 V58 H118 V68 H108 V70 H88 V68 H78 V58 H68 Z M146,10 H156 V0 H196 V10 H206 V20 H196 V10 H156 V60 H196 V50 H206 V60 H196 V70 H156 V60 H146 Z M224,10 H234 V0 H274 V10 H284 V60 H274 V70 H234 V60 H224 Z M234,10 V60 H274 V10 Z M302,0 H312 V10 H322 V20 H332 V10 H342 V0 H352 V70 H342 V25 H332 V35 H322 V25 H312 V70 H302 Z" />
                                </Canvas>
                                <Canvas Canvas.Left="198" Canvas.Top="174">
                                    <Path Fill="#F4F8FC" Data="M0,0 H40 V10 H50 V60 H40 V70 H0 Z M10,10 V60 H35 V50 H40 V20 H35 V10 Z M68,0 H78 V55 H88 V60 H108 V55 H118 V0 H128 V58 H118 V68 H108 V70 H88 V68 H78 V58 H68 Z" />
                                    <Path Fill="#42A5F5" Data="M146,10 H156 V0 H196 V10 H206 V20 H196 V10 H156 V60 H196 V50 H206 V60 H196 V70 H156 V60 H146 Z M224,10 H234 V0 H274 V10 H284 V60 H274 V70 H234 V60 H224 Z M234,10 V60 H274 V10 Z M302,0 H312 V10 H322 V20 H332 V10 H342 V0 H352 V70 H342 V25 H332 V35 H322 V25 H312 V70 H302 Z" />
                                    <Rectangle Canvas.Left="362" Canvas.Top="60" Width="10" Height="10" Fill="#90CAF9" />
                                </Canvas>

                                <Grid Canvas.Top="274" Width="800">
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                        <Rectangle Width="8" Height="8" Margin="0,0,12,0" VerticalAlignment="Center" Fill="#42A5F5" />
                                        <Rectangle Width="54" Height="4" Margin="0,0,16,0" VerticalAlignment="Center" Fill="#304A61" />
                                        <TextBlock Margin="0,0,16,0" VerticalAlignment="Center"
                                                   FontFamily="Consolas, Microsoft YaHei UI" FontSize="14"
                                                   FontWeight="Bold" Foreground="#8295A8"
                                                   Text="{DynamicResource Cover.Subtitle}" />
                                        <Rectangle Width="54" Height="4" Margin="0,0,12,0" VerticalAlignment="Center" Fill="#304A61" />
                                        <Rectangle Width="8" Height="8" VerticalAlignment="Center" Fill="#42A5F5" />
                                    </StackPanel>
                                </Grid>

                                <!-- Pixel equalizers stay inside the foreground safe area. -->
                                <StackPanel Canvas.Left="70" Canvas.Top="196" Height="96" VerticalAlignment="Bottom" Orientation="Horizontal">
                                    <Rectangle Width="8" Height="26" Margin="0,0,6,0" VerticalAlignment="Bottom" Fill="#22506E" />
                                    <Rectangle Width="8" Height="54" Margin="0,0,6,0" VerticalAlignment="Bottom" Fill="#2D739D" />
                                    <Rectangle Width="8" Height="34" Margin="0,0,6,0" VerticalAlignment="Bottom" Fill="#42A5F5" />
                                    <Rectangle Width="8" Height="70" VerticalAlignment="Bottom" Fill="#90CAF9">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CoverPageAnimationEnabled}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="LeftMeterAnimation">
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Height" From="18" To="82" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="LeftMeterAnimation" /></DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                </StackPanel>
                                <StackPanel Canvas.Left="684" Canvas.Top="196" Height="96" VerticalAlignment="Bottom" Orientation="Horizontal">
                                    <Rectangle Width="8" Height="64" Margin="0,0,6,0" VerticalAlignment="Bottom" Fill="#90CAF9">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CoverPageAnimationEnabled}" Value="True">
                                                        <DataTrigger.EnterActions>
