<ui:FluentWindow x:Class="DuCom.HighlightFilterRulesWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:local="clr-namespace:DuCom"
                  Title="{DynamicResource HighlightFilter.Title}"
                  Width="720"
                  Height="520"
                  Icon="/Assets/DuCom.ico"
                  MinWidth="560"
                 MinHeight="400"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="{DynamicResource HighlightFilter.Title}" />
        <local:HighlightFilterRulesControl Grid.Row="1" Margin="16" />
    </Grid>
</ui:FluentWindow>
