<UserControl x:Class="DuCom.SessionWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:DuCom.Behaviors"
             xmlns:converters="clr-namespace:DuCom.Converters"
             xmlns:controls="clr-namespace:DuCom.Controls"
             xmlns:local="clr-namespace:DuCom"
             xmlns:sending="clr-namespace:DuCom.Core.Sending;assembly=DuCom.Core"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:EqualityConverter x:Key="EqualityConverter" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding Search.OpenCommand}" />
    </UserControl.InputBindings>

    <Border Background="{DynamicResource Brush.PanelSurface}"
            BorderBrush="{DynamicResource Brush.PanelBorder}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Medium}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="4" />
                <RowDefinition Height="64" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Background="{DynamicResource Brush.LogSurface}">
                <controls:BoundedLogEditor x:Name="LogEditor"
                                           Padding="8,6"
                                           Background="Transparent"
                                           BorderThickness="0"
                                           CurrentMatch="{Binding Search.CurrentMatch}"
                                            FontFamily="{Binding DataContext.LogFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                            FontSize="{Binding DataContext.LogFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FollowEnd="{Binding FollowEnd}"
                                           Foreground="{DynamicResource Brush.LogText}"
                                           GotKeyboardFocus="LogEditor_GotKeyboardFocus"
                                           Lines="{Binding VisibleLines}"
                                           PreviewMouseLeftButtonDown="LogEditor_PreviewMouseLeftButtonDown"
                                           PreviewMouseWheel="LogEditor_PreviewMouseWheel"
                                           ShowLineNumbers="{Binding DataContext.ShowLineNumbers, RelativeSource={RelativeSource AncestorType=Window}}"
                                           ShowControlCharacters="{Binding DataContext.ShowControlCharacters, RelativeSource={RelativeSource AncestorType=Window}}"
                                           ShowSpaces="{Binding DataContext.ShowSpaces, RelativeSource={RelativeSource AncestorType=Window}}"
                                           ShowTabs="{Binding DataContext.ShowTabs, RelativeSource={RelativeSource AncestorType=Window}}"
                                           WordWrap="{Binding DataContext.WordWrap, RelativeSource={RelativeSource AncestorType=Window}}">
                    <controls:BoundedLogEditor.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="ApplicationCommands.Copy" Header="{DynamicResource Menu.Edit.CopyLog}" />
                            <MenuItem Command="ApplicationCommands.SelectAll" Header="{DynamicResource Log.SelectAll}" />
                        </ContextMenu>
                    </controls:BoundedLogEditor.ContextMenu>
                </controls:BoundedLogEditor>
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Panel.ZIndex="4"
                           Text="{DynamicResource Log.EmptyTitle}">
                    <TextBlock.Style>
                        <Style BasedOn="{StaticResource Style.MutedText}" TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding VisibleLines.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Border MaxWidth="560"
                        Margin="28"
                        Padding="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Brush.PanelRaised}"
                        BorderBrush="{DynamicResource Brush.Danger}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Medium}"
                        Panel.ZIndex="20"
                        Visibility="{Binding HasFault, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="52" Height="52" HorizontalAlignment="Center" Background="{DynamicResource Brush.DangerSoft}" CornerRadius="26">
                            <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="26" Foreground="{DynamicResource Brush.Danger}" Symbol="ErrorCircle24" />
                        </Border>
                        <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="{DynamicResource Connection.OpenFailedTitle}" />
                        <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{Binding PortName}" />
                        <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding FaultMessage}" TextAlignment="Center" TextWrapping="Wrap" />
                        <ui:Button Margin="0,18,0,0" MinWidth="120" HorizontalAlignment="Center" Appearance="Primary" Command="{Binding ToggleConnectionCommand}" Content="{DynamicResource Connection.Retry}" />
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Row="1"
                          Height="4"
                          HorizontalAlignment="Stretch"
                          ResizeDirection="Rows"
                          Style="{StaticResource Style.Splitter}" />

            <!--
                Bottom action bar (IDLE-style toolbar).
                Layout strategy:
                  Row 0: Three action groups separated by 1px dividers. Each group is
                         a horizontally aligned StackPanel of buttons/comboboxes with
                         the same 30px height so columns line up visually.
                  Row 1: Optional second row for the "command group" strip
                         (scripted commands + send button pair).
                The bars use a slightly raised toolbar surface so the log panel reads
                as the primary canvas.
            -->
            <Border Grid.Row="2"
                    Padding="10,7"
                    Background="{DynamicResource Brush.ToolbarSurface}"
                    BorderBrush="{DynamicResource Brush.PanelBorder}"
                    BorderThickness="0,1"
                    CornerRadius="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <!--
                        Bottom action bar. A WrapPanel lets the controls reflow onto a second
                        row when split-screen narrows the workspace, so no button is ever
                        clipped off-screen. Icon buttons carry Chinese tooltips only.
                    -->
                    <WrapPanel>
                        <!-- Connection (primary, compact) -->
                        <Button MinWidth="74"
                                 Margin="0,0,6,4"
                                 Command="{Binding ToggleConnectionCommand}"
                                 Style="{StaticResource Style.ToolbarPrimary}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon FontSize="15" Symbol="PlugConnected24" />
                                <TextBlock Margin="5,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{DynamicResource Connection.Open}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                    <Setter Property="Text" Value="{DynamicResource Connection.Close}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <Button.ToolTip>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{DynamicResource Connection.Open}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                    <Setter Property="Text" Value="{DynamicResource Connection.Close}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button.ToolTip>
                        </Button>
                        <Rectangle Margin="0,0,6,4" Style="{StaticResource Style.ToolbarSeparator}" />

                        <!-- Log view actions: Clear is icon+text, the rest are icon-only with Chinese tooltips -->
                        <Button Margin="0,0,2,4"
                                Style="{StaticResource Style.ToolbarButton}"
                                Command="{Binding ClearDisplayCommand}"
                                ToolTip="{DynamicResource Log.Clear}"
                                AutomationProperties.Name="{DynamicResource Log.Clear}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon FontSize="15" Symbol="EraserTool24" />
                                <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="{DynamicResource Log.Clear}" />
                            </StackPanel>
                        </Button>
                        <ToggleButton x:Name="FollowEndToggle"
                                      Margin="0,0,2,4"
                                      Click="FollowEndToggle_Click"
                                      IsChecked="{Binding FollowEnd, Mode=OneWay}"
                                      Style="{StaticResource Style.ToolbarIconToggle}"
                                      ToolTip="{DynamicResource Log.Follow}"
                                      AutomationProperties.Name="{DynamicResource Log.Follow}">
                            <ui:SymbolIcon FontSize="16" Symbol="ChevronDoubleDown16" />
                        </ToggleButton>
                        <Button Margin="0,0,2,4"
                                 Style="{StaticResource Style.ToolbarIconButton}"
                                 Command="{Binding DataContext.OpenLogFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                 CommandParameter="{Binding}"
                                 ToolTip="{DynamicResource Log.OpenFolder.Tooltip}"
                                AutomationProperties.Name="{DynamicResource Log.OpenFolder.Tooltip}">
                            <ui:SymbolIcon FontSize="16" Symbol="FolderOpen24" />
                        </Button>
                        <Button Margin="0,0,6,4"
                                Style="{StaticResource Style.ToolbarIconButton}"
                                Command="{Binding DataContext.ShowLogFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                ToolTip="{DynamicResource Menu.Tools.LogFilter}"
                                AutomationProperties.Name="{DynamicResource Menu.Tools.LogFilter}">
                            <ui:SymbolIcon FontSize="16" Symbol="Filter24" />
                        </Button>

                        <Rectangle Margin="0,0,6,4" Style="{StaticResource Style.ToolbarSeparator}" />

                        <!-- Port + send-config -->
                        <Button Margin="0,0,2,4"
                                Style="{StaticResource Style.ToolbarButton}"
                                Command="{Binding DataContext.OpenSerialParametersCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                ToolTip="{DynamicResource Settings.SerialParameters}"
                                AutomationProperties.Name="{DynamicResource Settings.SerialParameters}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon FontSize="15" Symbol="Settings24" />
                                <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="{DynamicResource Settings.SerialParameters}" />
                            </StackPanel>
                        </Button>
                        <ComboBox x:Name="BaudRateBox"
                                  Margin="0,0,2,4"
                                  MinWidth="104"
                                  Style="{StaticResource Style.ToolbarCombo}"
                                  ItemsSource="{Binding DataContext.BaudRates, RelativeSource={RelativeSource AncestorType=Window}}"
                                   SelectedItem="{Binding BaudRate, Mode=OneWay}"
                                   DataContextChanged="BaudRateBox_DataContextChanged"
                                   Loaded="BaudRateBox_Loaded"
                                   SelectionChanged="BaudRate_SelectionChanged" />
                        <Button x:Name="CommandMenuButton"
                                MinWidth="112"
                                Margin="0,0,0,4"
                                Click="CommandMenuButton_Click"
                                Style="{StaticResource Style.ToolbarButton}"
                                ToolTip="{DynamicResource Commands.SelectGroup}">
                            <Grid>
                                <TextBlock Margin="0,0,18,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           Text="{Binding SelectedCommandGroup.Name}" />
                                <TextBlock Margin="0,0,18,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           IsHitTestVisible="False"
                                           Text="{DynamicResource Commands.Placeholder}">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource Style.MutedText}" TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedCommandGroup}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ui:SymbolIcon HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Symbol="ChevronDown24" />
                            </Grid>
                            <Button.ContextMenu>
                                <ContextMenu Placement="Bottom" />
                            </Button.ContextMenu>
                        </Button>
                    </WrapPanel>

                    <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding SelectedGroupCommands}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,6,4"
                                        Padding="10,3"
                                        Command="{Binding DataContext.SendScriptCommandCommand, RelativeSource={RelativeSource AncestorType=local:SessionWorkspace}}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding Name}"
                                        ToolTip="{Binding Payload}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <GridSplitter Grid.Row="3"
                          Height="4"
                          HorizontalAlignment="Stretch"
                          ResizeDirection="Rows"
                          Style="{StaticResource Style.Splitter}" />

            <Grid Grid.Row="4" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SendEditor"
                         Padding="10,8"
                         Background="{DynamicResource Brush.InputSurface}"
                         BorderBrush="{DynamicResource Brush.InputBorder}"
                         BorderThickness="1"
                         FontFamily="Cascadia Mono, Consolas"
                         AcceptsReturn="False"
                         IsEnabled="{Binding IsOpen}"
                         PreviewKeyDown="SendEditor_PreviewKeyDown"
                         Text="{Binding SendText, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap"
                         ToolTip="{DynamicResource Send.InputHint}" />
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ui:Button Height="29"
                               MinWidth="44"
                               HorizontalAlignment="Stretch"
                               Command="{Binding ToggleCommandGroupRunCommand}"
                               ToolTip="{DynamicResource Commands.RunToggle}">
                        <ui:Button.Style>
                            <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                <Setter Property="Appearance" Value="Primary" />
                                <Setter Property="IsEnabled" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCommandGroupRunning}" Value="True">
                                        <Setter Property="Appearance" Value="Danger" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsCommandGroupRunning}" Value="False" />
                                            <Condition Binding="{Binding SelectedCommandGroup}" Value="{x:Null}" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="IsEnabled" Value="False" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Play24">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="Play24" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCommandGroupRunning}" Value="True">
                                                <Setter Property="Symbol" Value="Stop24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Grid.Row="2"
                               Height="29"
                               MinWidth="44"
                               HorizontalAlignment="Stretch"
                               Appearance="Primary"
                               Command="{Binding DataContext.SendSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                               CommandParameter="{Binding}"
                               ToolTip="{DynamicResource Send.Action}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon FontSize="16" Symbol="Send24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </Grid>

            <Border Margin="6"
                    Padding="8,6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{DynamicResource Brush.PanelRaised}"
                    BorderBrush="{DynamicResource Brush.PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Small}"
                    Panel.ZIndex="30"
                    Opacity="{Binding DataContext.SearchOpacity, RelativeSource={RelativeSource AncestorType=Window}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Search.IsOpen}" Value="True" />
                                    <Condition Binding="{Binding IsOpen}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="SearchTextBox"
                             MinWidth="180"
                             Text="{Binding Search.SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{DynamicResource Search.Placeholder}"
                             AutomationProperties.Name="{DynamicResource Search.Placeholder}" />
                    <ToggleButton MinWidth="56"
                                  Margin="4,0,0,0"
                                  Content="{DynamicResource Search.MatchCase.Short}"
                                  IsChecked="{Binding Search.MatchCase}"
                                  ToolTip="{DynamicResource Search.MatchCase}"
                                  AutomationProperties.Name="{DynamicResource Search.MatchCase}" />
                    <ToggleButton MinWidth="56"
                                  Margin="4,0,0,0"
                                  Content="{DynamicResource Search.MatchWholeLine.Short}"
                                  IsChecked="{Binding Search.MatchWholeLine}"
                                  ToolTip="{DynamicResource Search.MatchWholeLine}"
                                  AutomationProperties.Name="{DynamicResource Search.MatchWholeLine}" />
                    <Button Width="30"
                            Margin="4,0,0,0"
                            Padding="0"
                            Command="{Binding Search.FindPreviousCommand}"
                            Style="{StaticResource Style.IconButton}"
                            ToolTip="{DynamicResource Search.Previous}"
                            AutomationProperties.Name="{DynamicResource Search.Previous}">
                        <ui:SymbolIcon FontSize="14" Symbol="ChevronUp24" />
                    </Button>
                    <Button Width="30"
                            Margin="4,0,0,0"
                            Padding="0"
                            Command="{Binding Search.FindNextCommand}"
                            Style="{StaticResource Style.IconButton}"
                            ToolTip="{DynamicResource Search.Next}"
                            AutomationProperties.Name="{DynamicResource Search.Next}">
                        <ui:SymbolIcon FontSize="14" Symbol="ChevronDown24" />
                    </Button>
                    <TextBlock Margin="8,0" VerticalAlignment="Center" Text="{Binding Search.CurrentMatchDisplay}" />
                    <Button Width="30"
                            Padding="0"
                            Command="{Binding Search.CloseCommand}"
                            Style="{StaticResource Style.IconButton}"
                            ToolTip="{DynamicResource Search.Close}"
                            AutomationProperties.Name="{DynamicResource Search.Close}">
                        <ui:SymbolIcon FontSize="14" Symbol="Dismiss24" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
