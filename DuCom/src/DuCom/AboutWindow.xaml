<ui:FluentWindow x:Class="DuCom.AboutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="{DynamicResource About.Title}"
                  Width="520"
                  Height="420"
                  Icon="/Assets/DuCom.ico"
                  ExtendsContentIntoTitleBar="True"
                 ResizeMode="NoResize"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="{DynamicResource About.Title}" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Grid.Row="1" Margin="28,16,28,0">
            <TextBlock FontSize="34" FontWeight="SemiBold" Text="{Binding ProductName}" />
            <TextBlock Margin="0,4,0,0"
                       FontSize="14"
                       Style="{DynamicResource Style.MutedText}"
                       Text="{DynamicResource About.Description}" />
        </StackPanel>
        <Border Grid.Row="3" Margin="28,0" Style="{DynamicResource Style.SettingsCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{DynamicResource Style.MutedText}" Text="{DynamicResource About.Product}" />
                <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="{Binding ProductName}" />
                <TextBlock Grid.Row="2" Style="{DynamicResource Style.MutedText}" Text="{DynamicResource About.Version}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Version}" />
                <TextBlock Grid.Row="4" Style="{DynamicResource Style.MutedText}" Text="{DynamicResource About.ReleaseDate}" />
                <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding ReleaseDate}" />
                <TextBlock Grid.Row="6" Style="{DynamicResource Style.MutedText}" Text="{DynamicResource About.Author}" />
                <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding Author}" />
                <TextBlock Grid.Row="8" Style="{DynamicResource Style.MutedText}" Text="{DynamicResource About.CurrentTime}" />
                <TextBlock Grid.Row="8" Grid.Column="2" FontFamily="Cascadia Mono, Consolas" Text="{Binding CurrentTime}" />
            </Grid>
        </Border>
        <Button Grid.Row="4"
                MinWidth="96"
                Margin="0,0,28,24"
                HorizontalAlignment="Right"
                Click="Close_Click"
                Content="{DynamicResource About.Close}" />
    </Grid>
</ui:FluentWindow>
