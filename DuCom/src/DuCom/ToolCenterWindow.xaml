<ui:FluentWindow x:Class="DuCom.ToolCenterWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:diag="clr-namespace:DuCom.Core.Diagnostics;assembly=DuCom.Core"
                  xmlns:local="clr-namespace:DuCom"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="{DynamicResource Tools.Title}"
                  Width="920"
                  Height="620"
                  Icon="/Assets/DuCom.ico"
                  MinWidth="760"
                 MinHeight="520"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="{DynamicResource Tools.Title}" />
        <TabControl x:Name="RootTabs"
                    Grid.Row="1"
                    Margin="8"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Style="{StaticResource Style.EditorTabControl}">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem" BasedOn="{StaticResource Style.EditorTabItem}" />
            </TabControl.ItemContainerStyle>
            <TabItem Header="{DynamicResource Menu.Tools.Plugins}">
                <local:PluginManagerControl x:Name="PluginManagerHost" />
            </TabItem>
            <TabItem Header="{DynamicResource Menu.Tools.Monitor}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="28,28,28,0">
                         <TextBlock FontSize="30" FontWeight="SemiBold" Text="{Binding CpuText}" />
                         <TextBlock Margin="0,16,0,0" FontSize="18" Text="{Binding MemoryText}" />
                         <TextBlock Margin="0,10,0,0" Style="{DynamicResource Style.MutedText}" Text="{Binding RuntimeText}" />
                        <Border Margin="0,14,0,0" Padding="12" Style="{DynamicResource Style.SettingsCard}">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{DynamicResource Tools.PrivateMemoryMonitor.Title}" />
                                <TextBlock Margin="0,6,0,0" Text="{Binding PrivateMemoryMonitorStatus}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource Brush.Caution}"
                                           Text="{DynamicResource Tools.PrivateMemoryMonitor.Warning}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding IsPrivateMemoryWarningVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>
                     </StackPanel>
                    <Grid Grid.Row="1" Margin="28,16,28,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="{DynamicResource Tools.MonitorRules}" />
                    <StackPanel Grid.Row="1" Margin="0,8,0,0" Orientation="Horizontal">
                        <Button Command="{Binding AddMonitorRuleCommand}" Content="{DynamicResource Tools.MonitorAddRule}" />
                        <Button Margin="8,0,0,0" Command="{Binding SaveMonitorRulesCommand}" Content="{DynamicResource Tools.MonitorSave}" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{DynamicResource Style.MutedText}" Text="{DynamicResource Tools.MonitorHint}" />
                    </StackPanel>
                    <DataGrid Grid.Row="2"
                              MinHeight="90"
                              MaxHeight="180"
                              Margin="0,8,0,0"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              ItemsSource="{Binding MonitorRows}"
                              Style="{StaticResource Style.EditorDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="120" Binding="{Binding Name}" Header="{DynamicResource Tools.Name}" />
                            <DataGridTextColumn Width="80" Binding="{Binding PortName}" Header="{DynamicResource Tools.MonitorPort}" />
                            <DataGridTextColumn Width="2*" Binding="{Binding Pattern}" Header="{DynamicResource Watchdog.Pattern}" />
                            <DataGridCheckBoxColumn Width="52" Binding="{Binding IsEnabled}" Header="{DynamicResource Shortcut.Status}" />
                            <DataGridTextColumn Width="60" Binding="{Binding Order}" Header="{DynamicResource Commands.Order}" />
                            <DataGridTemplateColumn Width="Auto" Header="{DynamicResource Shortcut.Operation}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.DeleteMonitorRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Content="{DynamicResource History.DeleteEntry}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="3" Margin="0,12,0,0" Orientation="Horizontal">
                        <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{DynamicResource Tools.MonitorValues}" />
                        <Button Margin="24,0,0,0" Command="{Binding ExportMonitorCsvCommand}" Content="{DynamicResource Tools.MonitorExport}" />
                    </StackPanel>
                    <DataGrid Grid.Row="4"
                              Margin="0,8,0,0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              ItemsSource="{Binding MonitorValues}"
                              Style="{StaticResource Style.EditorDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="2*" Binding="{Binding Name}" Header="{DynamicResource Tools.Name}" />
                            <DataGridTextColumn Width="2*" Binding="{Binding Value}" Header="{DynamicResource Tools.MonitorValue}" />
                            <DataGridTextColumn Width="120" Binding="{Binding SampledAt}" Header="{DynamicResource Tools.MonitorTime}" />
                            <DataGridTextColumn Width="80" Binding="{Binding MatchCount}" Header="{DynamicResource Tools.MonitorCount}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource Menu.Tools.VirtualPort}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{DynamicResource Style.SettingsCard}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{DynamicResource Tools.Com0ComStatus}" />
                            <TextBlock Margin="0,6,0,0" Text="{Binding IsCom0ComAvailable}" />
                            <TextBox Margin="0,6,0,0"
                                     Text="{Binding Com0ComPath, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{DynamicResource Tools.Com0ComPathHint}" />
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                <Button Command="{Binding OpenCom0ComWebsiteCommand}" Content="{DynamicResource Tools.InstallCom0Com}" />
                                <Button Margin="8,0,0,0" Command="{Binding OpenCom0ComFolderCommand}" Content="{DynamicResource Tools.OpenCom0Com}" />
                                <Button Margin="8,0,0,0" Command="{Binding BrowseCom0ComSetupcCommand}" Content="{DynamicResource Tools.BrowseSetupc}" />
                                <Button Margin="8,0,0,0" Command="{Binding UseCom0ComPathCommand}" Content="{DynamicResource Tools.UseSetupcPath}" />
                                <Button Margin="8,0,0,0" Command="{Binding RefreshVirtualPortsCommand}" Content="{DynamicResource Connection.Refresh}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Style="{DynamicResource Style.SettingsCard}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{DynamicResource Tools.PairManagement}" />
                            <TextBlock Margin="0,6,0,0" Style="{DynamicResource Style.MutedText}" Text="{DynamicResource Tools.Com0ComAdminHint}" />
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                <TextBox Width="110"
                                         MaxLength="8"
                                         Tag="A"
                                         Text="{Binding NewPairPortA, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource Tools.PairPortA}" />
                                <Border Width="24"
                                        Height="1"
                                        Margin="8,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Brush.TextMuted}" />
                                <TextBox Width="110"
                                         MaxLength="8"
                                         Text="{Binding NewPairPortB, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource Tools.PairPortB}" />
                                <Button Margin="12,0,0,0" Command="{Binding InstallPairCommand}" Content="{DynamicResource Tools.InstallPair}" />
                                <Button Margin="8,0,0,0" Command="{Binding RefreshCom0ComPairsCommand}" Content="{DynamicResource Tools.RefreshPairs}" />
                            </StackPanel>
                            <WrapPanel Margin="0,10,0,0">
                                <CheckBox Margin="0,0,12,0" Content="EmuBR" IsChecked="{Binding PairEmuBR}" />
                                <CheckBox Margin="0,0,12,0" Content="EmuOverrun" IsChecked="{Binding PairEmuOverrun}" />
                                <CheckBox Margin="0,0,12,0" Content="HiddenMode" IsChecked="{Binding PairHiddenMode}" />
                                <CheckBox Margin="0,0,12,0" Content="PlugInMode" IsChecked="{Binding PairPlugInMode}" />
                                <CheckBox Margin="0,0,12,0" Content="ExclusiveMode" IsChecked="{Binding PairExclusiveMode}" />
                                <TextBox Width="64" Margin="0,0,4,0" Text="{Binding PairEmuNoise}" ToolTip="EmuNoise" />
                                <TextBox Width="64" Margin="0,0,4,0" Text="{Binding PairRtto}" ToolTip="AddRTTO ms" />
                                <TextBox Width="64" Text="{Binding PairRito}" ToolTip="AddRITO ms" />
                            </WrapPanel>
                            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource Brush.Caution}" Text="{Binding Com0ComStatus}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="{DynamicResource Tools.CurrentPairs}" />
                    <DataGrid Grid.Row="6"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              ItemsSource="{Binding Com0ComPairs}"
                              SelectedItem="{Binding SelectedCom0ComPair}"
                              Style="{StaticResource Style.EditorDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="60" Binding="{Binding PairNumber}" Header="#" />
                            <DataGridTextColumn Width="*" Binding="{Binding SideA.PortName}" Header="A" />
                            <DataGridTextColumn Width="*" Binding="{Binding SideB.PortName}" Header="B" />
                            <DataGridTemplateColumn Width="Auto" Header="{DynamicResource Shortcut.Operation}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Command="{Binding DataContext.ApplyPairOptionsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Content="{DynamicResource Tools.ApplyPairOptions}" />
                                            <Button Margin="6,0,0,0"
                                                    Command="{Binding DataContext.RemovePairCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Content="{DynamicResource Tools.RemovePair}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource Menu.Tools.Ascii}">
                <DataGrid Margin="8" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding AsciiRows}" Style="{StaticResource Style.EditorDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="*" Binding="{Binding DecimalValue}" Header="DEC" />
                        <DataGridTextColumn Width="*" Binding="{Binding Hex}" Header="HEX" />
                        <DataGridTextColumn Width="2*" Binding="{Binding Character}" Header="ASCII" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="{DynamicResource Menu.Tools.References}">
                <StackPanel Margin="28">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="{DynamicResource Tools.ReferenceTitle}" />
                    <TextBlock Margin="0,10,0,18" Style="{DynamicResource Style.MutedText}" Text="{DynamicResource Tools.ReferenceDescription}" />
                    <Button HorizontalAlignment="Left" Command="{Binding OpenDocumentationCommand}" Content="{DynamicResource Menu.Tools.Documentation}" />
                </StackPanel>
            </TabItem>
            <TabItem Header="{DynamicResource Menu.Tools.Telnet}">
                <StackPanel Margin="28">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="{DynamicResource Tools.TelnetTitle}" />
                    <TextBlock Margin="0,10,0,0" Style="{DynamicResource Style.FieldLabel}" Text="{DynamicResource Tools.ListenPort}" />
                    <TextBox Width="160" HorizontalAlignment="Left" Text="{Binding TelnetPort}" />
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <CheckBox VerticalAlignment="Center" Content="{DynamicResource Tools.TelnetAllowRemote}" IsChecked="{Binding TelnetAllowRemote}" />
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{DynamicResource Brush.Caution}"
                               MaxWidth="640"
                               Style="{DynamicResource Style.MutedText}"
                               Text="{DynamicResource Tools.TelnetRemoteWarning}"
                               TextWrapping="Wrap"
                               Visibility="{Binding TelnetAllowRemote, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <CheckBox Margin="0,12,0,0"
                              HorizontalAlignment="Left"
                              Content="{DynamicResource Tools.TelnetAuthenticationEnabled}"
                              IsChecked="{Binding TelnetAuthenticationEnabled}" />
                    <TextBlock Margin="0,8,0,0" Style="{DynamicResource Style.FieldLabel}" Text="{DynamicResource Tools.TelnetUsername}" />
                    <TextBox Width="240" HorizontalAlignment="Left" Text="{Binding TelnetUsername, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,8,0,0" Style="{DynamicResource Style.FieldLabel}" Text="{DynamicResource Tools.TelnetPassword}" />
                    <PasswordBox Width="240" HorizontalAlignment="Left" PasswordChanged="TelnetPassword_PasswordChanged" />
                    <TextBlock MaxWidth="640"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Left"
                               Style="{DynamicResource Style.MutedText}"
                               Text="{DynamicResource Tools.TelnetPasswordRuntimeOnly}"
                               TextWrapping="Wrap" />
                    <Button Width="140" Margin="0,16,0,0" HorizontalAlignment="Left" Command="{Binding ToggleTelnetCommand}" Content="{DynamicResource Tools.StartStop}" />
                    <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Tools.TelnetRunning}" />
                        <TextBlock Margin="6,0,0,0" Text="{Binding IsTelnetRunning}" />
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0" Style="{DynamicResource Style.MutedText}" Text="{DynamicResource Tools.TelnetListenAddress}" />
                    <TextBlock Margin="0,2,0,0" FontWeight="SemiBold" Text="{Binding TelnetListenAddressText}" />
                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Tools.TelnetClients}" />
                        <TextBlock Margin="6,0,0,0" Text="{Binding TelnetClientCount}" />
                    </StackPanel>
                    <ListBox MinHeight="60"
                             MaxHeight="120"
                             Margin="0,8,0,0"
                             HorizontalAlignment="Left"
                             ItemsSource="{Binding TelnetClients}" />
                    <Separator Margin="0,14,0,14" />
                    <TextBlock FontWeight="SemiBold" Text="{DynamicResource Tools.BridgeTitle}" />
                    <TextBlock Margin="0,6,0,0" Style="{DynamicResource Style.MutedText}" Text="{DynamicResource Tools.BridgeDescription}" />
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <ComboBox Width="140"
                                  ItemsSource="{Binding BridgePortOptions}"
                                  SelectedItem="{Binding BridgePortName}" />
                        <Button Margin="8,0,0,0" Command="{Binding RefreshBridgePortsCommand}" Content="{DynamicResource Connection.Refresh}" />
                        <Button Margin="8,0,0,0" Command="{Binding ToggleBridgeCommand}" Content="{DynamicResource Tools.BridgeToggle}" />
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource Brush.Caution}" Text="{Binding TelnetBridgeStatus}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,16,0,0" Style="{DynamicResource Style.MutedText}" Text="{DynamicResource Tools.TelnetDescription}" />
                </StackPanel>
            </TabItem>
            <TabItem Header="{DynamicResource Menu.Tools.Commands}">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{DynamicResource Commands.GroupNameHint}" />
                        <ListBox Grid.Row="1"
                                  Margin="0,8,0,8"
                                  ItemsSource="{Binding CommandGroups}"
                                  SelectedItem="{Binding SelectedCommandGroup}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource Style.EditorListItem}" />
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock Margin="6,0,0,0"
                                                   Style="{DynamicResource Style.MutedText}"
                                                   Text="{Binding CommandCount}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button Command="{Binding AddCommandGroupCommand}" Content="{DynamicResource Commands.NewGroup}" />
                            <Button Margin="6,0,0,0"
                                    Command="{Binding RenameSelectedCommandGroupCommand}"
                                    CommandParameter="{Binding NewGroupName}"
                                    Content="{DynamicResource Commands.RenameGroup}" />
                            <Button Margin="6,0,0,0" Command="{Binding DeleteSelectedCommandGroupCommand}" Content="{DynamicResource Commands.DeleteGroup}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Margin="0,6,0,0" Orientation="Horizontal">
                            <Button Command="{Binding ImportCommandGroupCommand}" Content="{DynamicResource Commands.Import}" />
                            <Button Margin="6,0,0,0" Command="{Binding ExportSelectedCommandGroupCommand}" Content="{DynamicResource Commands.Export}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Padding="8" BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{DynamicResource Commands.TargetPorts}" />
                                <TextBlock Margin="0,2,0,6" Style="{DynamicResource Style.MutedText}" Text="{DynamicResource Commands.TargetPortsHint}" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding CommandTargetPorts}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Margin="0,0,16,4" IsChecked="{Binding IsSelected}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding PortName}" />
                                                    <TextBlock Margin="6,0,0,0" Style="{DynamicResource Style.MutedText}" Text="{Binding StateText}" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <DataGrid x:Name="CommandsGrid"
                                  Grid.Row="1"
                                  Margin="0,8,0,0"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  ItemsSource="{Binding SelectedCommands}"
                                  CellEditEnding="CommandsGrid_CellEditEnding"
                                  Style="{StaticResource Style.EditorDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="48" Binding="{Binding OrderValue}" Header="{DynamicResource Commands.Order}" />
                                <DataGridTextColumn Width="120" Binding="{Binding NameText}" Header="{DynamicResource Tools.Name}" />
                                <DataGridTextColumn Width="2*" Binding="{Binding PayloadText}" Header="{DynamicResource Commands.Payload}" />
                                <DataGridCheckBoxColumn Width="52" Binding="{Binding IsHexEnabled}" Header="HEX" />
                                <DataGridTextColumn Width="70" Binding="{Binding DelayMsValue}" Header="{DynamicResource Commands.Delay}" />
                                <DataGridCheckBoxColumn Width="90" Binding="{Binding HasResultCheck}" Header="{DynamicResource Commands.ResultCheck}" />
                                <DataGridTextColumn Width="130" Binding="{Binding ExpectedResultText}" Header="{DynamicResource Commands.ExpectedResult}" />
                                 <DataGridTextColumn Width="80" Binding="{Binding ResultTimeoutMsValue}" Header="{DynamicResource Commands.Timeout}" />
                                 <DataGridTextColumn Width="110" Binding="{Binding StateText}" Header="{DynamicResource Commands.State}" />
                                <DataGridComboBoxColumn Width="80" Header="{DynamicResource Send.NewlineLabel}"
                                                        SelectedValueBinding="{Binding SelectedNewline}"
                                                        ItemsSource="{Binding DataContext.NewlineOptions, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <DataGridTemplateColumn Width="56">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Padding="2,0"
                                                    Command="{Binding DataContext.DeleteScriptCommandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource Style.IconButton}">
                                                <ui:SymbolIcon FontSize="14" Symbol="Dismiss24" />
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="2" Margin="0,8,0,0" Orientation="Horizontal">
                            <Button Command="{Binding AddScriptCommandCommand}" Content="{DynamicResource Commands.AddCommand}" />
                            <Button Margin="8,0,0,0"
                                    Command="{Binding StartSelectedCommandGroupCommand}"
                                    Content="{DynamicResource Commands.Start}" />
                            <Button Margin="8,0,0,0" Command="{Binding StopSelectedCommandGroupCommand}" Content="{DynamicResource Commands.Stop}" />
                            <TextBlock Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Success}"
                                       Text="{DynamicResource Commands.Running}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunnerRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                         </StackPanel>
                         <TextBlock Grid.Row="2"
                                    Margin="280,8,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource Brush.Caution}"
                                    Text="{Binding CommandMessage}" />
                     </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource Menu.Tools.Watchdog}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding AddWatchdogRuleCommand}" Content="{DynamicResource Watchdog.Add}" />
                        <TextBlock Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource Style.MutedText}"
                                   Text="{DynamicResource Watchdog.Hint}" />
                    </StackPanel>
                    <DataGrid Grid.Row="1"
                              Margin="0,12,0,0"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              ItemsSource="{Binding WatchdogRows}"
                              Style="{StaticResource Style.EditorDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="120" Binding="{Binding Name}" Header="{DynamicResource Tools.Name}" />
                            <DataGridTextColumn Width="2*" Binding="{Binding Pattern}" Header="{DynamicResource Watchdog.Pattern}" />
                            <DataGridComboBoxColumn Width="90"
                                                    Header="{DynamicResource Watchdog.Mode}"
                                                    ItemsSource="{Binding Source={x:Static diag:WatchdogMatchModeHelper.All}}"
                                                    SelectedItemBinding="{Binding Mode}" />
                            <DataGridCheckBoxColumn Width="52" Binding="{Binding IsCaseSensitive}" Header="{DynamicResource Watchdog.Case}" />
                            <DataGridCheckBoxColumn Width="52" Binding="{Binding IsEnabled}" Header="{DynamicResource Shortcut.Status}" />
                            <DataGridTextColumn Width="80" Binding="{Binding ExpectWithinSeconds}" Header="{DynamicResource Watchdog.Expect}" />
                            <DataGridTextColumn Width="80" Binding="{Binding ThrottleSeconds}" Header="{DynamicResource Watchdog.Throttle}" />
                            <DataGridComboBoxColumn Width="110"
                                                    Header="{DynamicResource Watchdog.Action}"
                                                    ItemsSource="{Binding Source={x:Static diag:WatchdogActionKindHelper.All}}"
                                                    SelectedItemBinding="{Binding ActionKind}" />
                            <DataGridTextColumn Width="*" Binding="{Binding ActionCommand}" Header="{DynamicResource Watchdog.Command}" />
                            <DataGridTemplateColumn Width="Auto" Header="{DynamicResource Shortcut.Operation}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.DeleteWatchdogRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Content="{DynamicResource History.DeleteEntry}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Command="{Binding SaveWatchdogRulesCommand}" Content="{DynamicResource Watchdog.Save}" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource Menu.Tools.SendHistory}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SendHistorySearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{DynamicResource History.SearchHint}" />
                        <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding ClearSendHistoryCommand}" Content="{DynamicResource History.ClearAll}" />
                        <TextBlock Grid.Column="2" Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource Style.MutedText}"
                                   Text="{DynamicResource History.Hint}" />
                    </Grid>
                    <ListBox x:Name="HistoryList"
                             Grid.Row="1"
                             Margin="0,12,0,0"
                             ItemsSource="{Binding SendHistoryList}"
                             MouseDoubleClick="SendHistory_MouseDoubleClick"
                              SelectionMode="Single">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource Style.EditorListItem}" />
                        </ListBox.ItemContainerStyle>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Click="UseSendHistory_Click" Header="{DynamicResource History.Use}" />
                                <MenuItem Command="{Binding DataContext.DeleteSendHistoryEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          Header="{DynamicResource History.DeleteEntry}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</ui:FluentWindow>
