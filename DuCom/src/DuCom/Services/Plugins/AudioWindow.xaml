<ui:FluentWindow x:Class="DuCom.Services.Plugins.AudioWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:local="clr-namespace:DuCom.Services.Plugins"
 xmlns:controls="clr-namespace:DuCom.Controls"
 Title="DuAudio · 语音合成工作台" Icon="/DuCom;component/Assets/DuCom.ico" Width="1180" Height="900" MinWidth="800" MinHeight="720"
 WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True"
 Background="{DynamicResource Audio.Bg}" Foreground="{DynamicResource Audio.Text}"
 FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
 UseLayoutRounding="True" SnapsToDevicePixels="True"
 TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
 <ui:FluentWindow.Resources>
  <SolidColorBrush x:Key="Audio.Bg" Color="#101216"/>
  <SolidColorBrush x:Key="Audio.Panel" Color="#191C22"/>
  <SolidColorBrush x:Key="Audio.Inset" Color="#14171C"/>
  <SolidColorBrush x:Key="Audio.Raised" Color="#242933"/>
  <SolidColorBrush x:Key="Audio.Border" Color="#2B303A"/>
  <SolidColorBrush x:Key="Audio.Strong" Color="#414956"/>
  <SolidColorBrush x:Key="Audio.Text" Color="#EFF2F8"/>
  <SolidColorBrush x:Key="Audio.Secondary" Color="#BBC3D1"/>
  <SolidColorBrush x:Key="Audio.Muted" Color="#909CAF"/>
  <SolidColorBrush x:Key="Audio.Primary" Color="#82A6FF"/>
  <SolidColorBrush x:Key="Audio.Accent" Color="#466FE5"/>
  <SolidColorBrush x:Key="Audio.Soft" Color="#1A82A6FF"/>
  <SolidColorBrush x:Key="Audio.Selected" Color="#26334C"/>
  <SolidColorBrush x:Key="Audio.Hover" Color="#222A39"/>
  <SolidColorBrush x:Key="Audio.Green" Color="#71D8B0"/>
  <SolidColorBrush x:Key="Audio.Error" Color="#FF8295"/>
  <Style TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource Audio.Text}"/>
  </Style>
  <Style x:Key="Audio.Caption" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource Audio.Muted}"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Audio.Card" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource Audio.Panel}"/><Setter Property="BorderBrush" Value="{DynamicResource Audio.Border}"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="21,18,21,21"/>
   <Setter Property="Margin" Value="0,0,0,20"/><Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>
  <Style x:Key="Audio.Button" TargetType="Button">
   <Setter Property="Background" Value="{DynamicResource Audio.Panel}"/><Setter Property="Foreground" Value="{DynamicResource Audio.Secondary}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Audio.Border}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="12,6"/><Setter Property="MinHeight" Value="32"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontSize" Value="12"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Audio.Hover}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Audio.Strong}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.75"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Audio.Primary}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource Audio.Button}"/>
  <Style x:Key="Audio.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Audio.Button}">
   <Setter Property="Background" Value="{DynamicResource Audio.Accent}"/><Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Audio.Accent}"/><Setter Property="Height" Value="44"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="Audio.Mini" TargetType="Button" BasedOn="{StaticResource Audio.Button}">
   <Setter Property="MinHeight" Value="26"/><Setter Property="Padding" Value="9,3"/><Setter Property="FontSize" Value="11"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="{DynamicResource Audio.Inset}"/><Setter Property="Foreground" Value="{DynamicResource Audio.Text}"/>
   <Setter Property="CaretBrush" Value="{DynamicResource Audio.Primary}"/><Setter Property="SelectionBrush" Value="{DynamicResource Audio.Selected}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Audio.Border}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="11,9"/><Setter Property="FontSize" Value="12"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
     <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Audio.Primary}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBox">
   <Setter Property="Background" Value="{DynamicResource Audio.Inset}"/><Setter Property="BorderBrush" Value="{DynamicResource Audio.Border}"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="0"/>
   <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
   <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
   <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
   <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" ClipToBounds="True">
     <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"><ItemsPresenter/></ScrollViewer>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Foreground" Value="{DynamicResource Audio.Text}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Row" Background="Transparent" BorderBrush="{DynamicResource Audio.Border}" BorderThickness="0,0,0,1">
     <Grid><Border x:Name="Selection" Width="2" Background="Transparent" HorizontalAlignment="Left"/><ContentPresenter/></Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Audio.Hover}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Audio.Selected}"/><Setter TargetName="Selection" Property="Background" Value="{DynamicResource Audio.Primary}"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Audio.Selected}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider">
   <Setter Property="Minimum" Value="-100"/><Setter Property="Maximum" Value="100"/><Setter Property="TickFrequency" Value="5"/><Setter Property="IsSnapToTickEnabled" Value="True"/>
   <Setter Property="Height" Value="24"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid Margin="7,0">
     <Border Height="4" CornerRadius="2" Background="{DynamicResource Audio.Strong}" VerticalAlignment="Center"/>
     <Track x:Name="PART_Track" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
      <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="{DynamicResource Audio.Primary}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
      <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
      <Track.Thumb><Thumb Width="14" Height="14"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{DynamicResource Audio.Raised}" Stroke="{DynamicResource Audio.Primary}" StrokeThickness="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     </Track>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Audio.Segment" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{DynamicResource Audio.Secondary}"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Padding" Value="10,7"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Segment" CornerRadius="7" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Segment" Property="Background" Value="{DynamicResource Audio.Raised}"/><Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource Audio.Border}"/><Setter Property="Foreground" Value="{DynamicResource Audio.Primary}"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Audio.Primary}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource Audio.Primary}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="Audio.VoiceTemplate">
   <Grid Margin="9,9" MinHeight="40">
    <Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Width="28" Height="32" CornerRadius="8" VerticalAlignment="Center" Background="{Binding AvatarBrush}"><TextBlock Text="{Binding Initial}" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,5,0">
     <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
     <TextBlock Text="{Binding Meta}" Foreground="{DynamicResource Audio.Muted}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
    <Button Grid.Column="2" Width="28" Height="28" MinHeight="28" Padding="6" Click="VoicePreview_Click" ToolTip="在线试听此语音" AutomationProperties.Name="在线试听此语音">
     <Path Data="M3,9 L7,9 12,5 12,19 7,15 3,15 Z M16,8 C20,10 20,14 16,16 M18,4 C26,9 26,15 18,20" Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource Audio.Secondary}" StrokeThickness="1.6"/>
    </Button>
   </Grid>
  </DataTemplate>
 </ui:FluentWindow.Resources>
 <Grid>
  <Grid.Background><DynamicResource ResourceKey="Audio.Bg"/></Grid.Background>
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <ui:TitleBar x:Name="AudioTitleBar" Height="48" Title="DuCom · 语音合成" Foreground="{DynamicResource Audio.Text}" ShowClose="False" ShowMaximize="False" ShowMinimize="False"><ui:TitleBar.TrailingContent><StackPanel Orientation="Horizontal" Height="48" VerticalAlignment="Center">
   <ToggleButton x:Name="PinInput" Width="46" Height="48" Checked="Pin_Changed" Unchecked="Pin_Changed" ToolTip="置顶窗口" AutomationProperties.Name="置顶窗口" Cursor="Hand">
    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="PinChrome" Background="Transparent"><Path Data="M8,2 L16,2 M10,2 L10,9 6,14 18,14 14,9 14,2 M12,14 L12,22" Width="14" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" Stroke="{DynamicResource Audio.Secondary}" StrokeThickness="1.6" Stretch="Uniform"/></Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PinChrome" Property="Background" Value="{DynamicResource Audio.Hover}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="PinChrome" Property="Background" Value="{DynamicResource Audio.Selected}"/><Setter Property="ToolTip" Value="取消置顶"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PinChrome" Property="BorderBrush" Value="{DynamicResource Audio.Primary}"/><Setter TargetName="PinChrome" Property="BorderThickness" Value="1"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
   </ToggleButton>
   <controls:WindowCaptionButtons x:Name="CaptionButtons" ShowMaximize="True" ShowMinimize="True"/>
  </StackPanel></ui:TitleBar.TrailingContent></ui:TitleBar>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="1440" Margin="32,0,32,28">
    <Grid Height="88" Margin="0,0,0,22">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border BorderBrush="{DynamicResource Audio.Border}" BorderThickness="0,0,0,1" Grid.ColumnSpan="4" VerticalAlignment="Bottom"/>
     <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource Audio.Soft}" BorderBrush="{DynamicResource Audio.Border}" BorderThickness="1" VerticalAlignment="Center">
      <Path Data="M3,12 L3,10 C3,0 21,0 21,10 L21,16 M3,13 L6,13 C8,13 8,20 6,20 L3,20 Z M21,13 L18,13 C16,13 16,20 18,20 L21,20 Z M21,18 C21,23 17,23 12,23" Stroke="{DynamicResource Audio.Primary}" StrokeThickness="1.8" Stretch="Uniform" Width="22" Height="23"/>
     </Border>
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Foreground="{DynamicResource Audio.Text}"><Run Text="Du"/><Run Text="Audio" Foreground="{DynamicResource Audio.Primary}"/><Run Text=" · 语音合成工作台"/></TextBlock>
     <Border Grid.Column="2" Background="{DynamicResource Audio.Inset}" BorderBrush="{DynamicResource Audio.Border}" BorderThickness="1" CornerRadius="11" Padding="3" VerticalAlignment="Center" Margin="8,0,12,0">
      <StackPanel Orientation="Horizontal"><RadioButton x:Name="LightTheme" Content="浅色" Style="{StaticResource Audio.Segment}" GroupName="theme" Checked="Theme_Changed"/><RadioButton x:Name="DarkTheme" Content="深色" Style="{StaticResource Audio.Segment}" GroupName="theme" Checked="Theme_Changed" IsChecked="True"/><RadioButton x:Name="SystemTheme" Content="系统" Style="{StaticResource Audio.Segment}" GroupName="theme" Checked="Theme_Changed"/></StackPanel>
     </Border>
     <Border Grid.Column="3" Background="{DynamicResource Audio.Panel}" BorderBrush="{DynamicResource Audio.Border}" BorderThickness="1" CornerRadius="17" Padding="12,8" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource Audio.Muted}" Margin="0,0,8,0"/><TextBlock x:Name="ConnectionText" Text="准备就绪" FontSize="12" Foreground="{DynamicResource Audio.Secondary}"/></StackPanel></Border>
    </Grid>
    <Grid x:Name="Workbench">
     <Grid.ColumnDefinitions><ColumnDefinition x:Name="LeftColumn" Width="310"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel>
      <Border Style="{StaticResource Audio.Card}"><StackPanel>
       <DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="刷新" Style="{StaticResource Audio.Mini}" Click="Refresh_Click"/><TextBlock x:Name="VoiceCount" DockPanel.Dock="Right" Text="—" Style="{StaticResource Audio.Caption}" Margin="0,0,10,0" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal"><Border Background="{DynamicResource Audio.Soft}" CornerRadius="7" Width="25" Height="25" Margin="0,0,9,0"><Path Data="M4,12 L12,4 20,12 12,20 Z M8,12 L12,8 16,12 12,16 Z" Stroke="{DynamicResource Audio.Primary}" StrokeThickness="1.5" Stretch="Uniform" Width="15" Height="15"/></Border><TextBlock Text="语音库" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></DockPanel>
       <Grid><TextBox x:Name="SearchInput" Height="40" Padding="32,9,10,9" TextChanged="Search_Changed" AutomationProperties.Name="搜索语音"/><Path Data="M18,10 A8,8 0 1 1 2,10 A8,8 0 1 1 18,10 M16,16 L23,23" Stroke="{DynamicResource Audio.Muted}" StrokeThickness="1.7" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False"/><TextBlock Text="搜索语音 / 语言 / 地区…" Foreground="{DynamicResource Audio.Muted}" FontSize="12" Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
       <ListBox x:Name="VoiceList" Height="288" Margin="0,12,0,0" ItemTemplate="{StaticResource Audio.VoiceTemplate}" SelectionChanged="Voice_Changed" AutomationProperties.Name="在线语音列表"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Audio.Card}"><StackPanel>
       <DockPanel Margin="0,0,0,20"><Button DockPanel.Dock="Right" Content="重置" Style="{StaticResource Audio.Mini}" Click="Reset_Click"/><StackPanel Orientation="Horizontal"><Border Background="{DynamicResource Audio.Soft}" CornerRadius="7" Width="25" Height="25" Margin="0,0,9,0"><Path Data="M3,6 L21,6 M3,12 L21,12 M3,18 L21,18 M8,3 L8,9 M16,9 L16,15 M10,15 L10,21" Stroke="{DynamicResource Audio.Primary}" StrokeThickness="1.6" Stretch="Uniform" Width="15" Height="15"/></Border><TextBlock Text="参数调节" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></DockPanel>
       <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock Text="语速" VerticalAlignment="Center" Foreground="{DynamicResource Audio.Secondary}"/><Slider x:Name="RateInput" Grid.Column="1" Maximum="200" ValueChanged="Parameter_Changed" AutomationProperties.Name="语速"/><Border Grid.Column="2" CornerRadius="7" Background="{DynamicResource Audio.Inset}" BorderBrush="{DynamicResource Audio.Border}" BorderThickness="1" Padding="5,4"><TextBlock x:Name="RateValue" Text="+0%" FontFamily="Cascadia Code, Consolas" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource Audio.Secondary}"/></Border></Grid>
       <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock Text="音调" VerticalAlignment="Center" Foreground="{DynamicResource Audio.Secondary}"/><Slider x:Name="PitchInput" Grid.Column="1" Minimum="-50" Maximum="50" ValueChanged="Parameter_Changed" AutomationProperties.Name="音调"/><Border Grid.Column="2" CornerRadius="7" Background="{DynamicResource Audio.Inset}" BorderBrush="{DynamicResource Audio.Border}" BorderThickness="1" Padding="5,4"><TextBlock x:Name="PitchValue" Text="+0Hz" FontFamily="Cascadia Code, Consolas" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource Audio.Secondary}"/></Border></Grid>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock Text="音量" VerticalAlignment="Center" Foreground="{DynamicResource Audio.Secondary}"/><Slider x:Name="VolumeInput" Grid.Column="1" ValueChanged="Parameter_Changed" AutomationProperties.Name="音量"/><Border Grid.Column="2" CornerRadius="7" Background="{DynamicResource Audio.Inset}" BorderBrush="{DynamicResource Audio.Border}" BorderThickness="1" Padding="5,4"><TextBlock x:Name="VolumeValue" Text="+0%" FontFamily="Cascadia Code, Consolas" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource Audio.Secondary}"/></Border></Grid>
       <TextBlock Text="字幕粒度" Foreground="{DynamicResource Audio.Secondary}" FontSize="12" Margin="0,22,0,7"/>
       <Border Background="{DynamicResource Audio.Inset}" CornerRadius="10" BorderBrush="{DynamicResource Audio.Border}" BorderThickness="1" Padding="3"><UniformGrid Columns="2"><RadioButton x:Name="SentenceBoundary" Content="按句" GroupName="boundary" IsChecked="True" Style="{StaticResource Audio.Segment}"/><RadioButton x:Name="WordBoundary" Content="按词" GroupName="boundary" Style="{StaticResource Audio.Segment}"/></UniformGrid></Border>
       <Border BorderBrush="{DynamicResource Audio.Border}" BorderThickness="0,1,0,0" Margin="0,19,0,0" Padding="0,15,0,0"><StackPanel><TextBlock Text="按所选格式保存文件" FontSize="12"/><TextBlock x:Name="DirectoryHint" Text="跟随 DuCom 当前日志目录" Style="{StaticResource Audio.Caption}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxHeight="32"/></StackPanel></Border>
      </StackPanel></Border>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <Border Style="{StaticResource Audio.Card}" BorderBrush="{DynamicResource Audio.Strong}"><StackPanel>
       <DockPanel Margin="0,2,0,17"><Button Content="导入 TXT / MD" DockPanel.Dock="Right" Style="{StaticResource Audio.Mini}" Click="Import_Click"/><StackPanel Orientation="Horizontal"><Border Width="25" Height="25" CornerRadius="7" Background="{DynamicResource Audio.Soft}" Margin="0,0,9,0"><Path Data="M4,20 L5,14 17,2 22,7 10,19 Z M14,5 L19,10 M5,14 L10,19" Stroke="{DynamicResource Audio.Primary}" StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform"/></Border><TextBlock Text="文本输入" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></DockPanel>
       <Grid><TextBox x:Name="TextEditor" Height="286" MinHeight="180" AcceptsReturn="True" AcceptsTab="True" MaxLength="40000" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="15" Padding="18,15" VerticalContentAlignment="Top" TextChanged="Text_Changed" AllowDrop="True" PreviewDragOver="Text_DragOver" PreviewDrop="Text_Drop" AutomationProperties.Name="合成文本"/>
        <TextBlock Text="输入或粘贴要转换为语音的文本…&#10;支持多段文本，长文本自动分块合成。" Margin="20,18" Foreground="{DynamicResource Audio.Muted}" FontSize="15" LineHeight="29" IsHitTestVisible="False" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=TextEditor}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       </Grid>
       <DockPanel Margin="0,12,0,0"><TextBlock Text="勾选格式后自动保存" DockPanel.Dock="Right" Style="{StaticResource Audio.Caption}"/><TextBlock x:Name="TextMeta" Text="字符  0       预计  0:00" FontSize="12" Foreground="{DynamicResource Audio.Muted}"/></DockPanel>
       <Border Background="{DynamicResource Audio.Inset}" BorderBrush="{DynamicResource Audio.Border}" BorderThickness="1" CornerRadius="10" Margin="0,18,0,0"><DockPanel><TextBlock Text="文件名" Style="{StaticResource Audio.Caption}" Margin="12,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Left"/><TextBlock Text=".srt 字幕同步" Style="{StaticResource Audio.Caption}" Margin="0,0,12,0" VerticalAlignment="Center" DockPanel.Dock="Right"/><Grid><TextBox x:Name="FilenameInput" Height="40" BorderThickness="0" FontFamily="Cascadia Code, Consolas" AutomationProperties.Name="输出文件名"/><TextBlock Text="留空自动使用时间戳" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Audio.Caption}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=FilenameInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel></Border>
       <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource Audio.Inset}" BorderBrush="{DynamicResource Audio.Border}" BorderThickness="1" CornerRadius="9" Padding="12,10" MinHeight="44">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="CurrentVoice" Text="晓晓" FontSize="13" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          <TextBlock x:Name="CurrentLocale" Grid.Column="1" Text="中文" Foreground="{DynamicResource Audio.Muted}" FontSize="12" TextWrapping="NoWrap" VerticalAlignment="Center" MaxWidth="140" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
         </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBlock Text="输出格式" Foreground="{DynamicResource Audio.Muted}" FontSize="12" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
         <Border Grid.Column="1" Background="{DynamicResource Audio.Inset}" CornerRadius="8" BorderBrush="{DynamicResource Audio.Border}" BorderThickness="1" Padding="12,8"><StackPanel Orientation="Horizontal"><CheckBox x:Name="ExportMp3" Content="MP3" IsChecked="True" Foreground="{DynamicResource Audio.Text}" Margin="0,0,16,0"/><CheckBox x:Name="ExportSrt" Content="SRT" IsChecked="True" Foreground="{DynamicResource Audio.Text}"/></StackPanel></Border>
        </Grid>
       </Grid>
       <Border BorderBrush="{DynamicResource Audio.Border}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="82"/><ColumnDefinition Width="8"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions><Button x:Name="GenerateButton" Style="{StaticResource Audio.PrimaryButton}" Content="开始合成" Click="Generate_Click"/><Button x:Name="PreviewButton" Grid.Column="2" Content="试听" Height="44" Click="Preview_Click"/><Button x:Name="ClearButton" Grid.Column="4" Content="清空" Height="44" Background="Transparent" BorderThickness="0" Click="Clear_Click"/></Grid></Border>
       <Grid x:Name="ProgressPanel" Margin="0,12,0,0" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ProgressBar x:Name="SynthesisProgress" Height="5" Background="{DynamicResource Audio.Strong}" Foreground="{DynamicResource Audio.Primary}" BorderThickness="0" VerticalAlignment="Center"/><TextBlock x:Name="PercentText" Grid.Column="1" Text="0%" FontSize="12" Margin="12,0,0,0" Foreground="{DynamicResource Audio.Primary}"/></Grid>
       <TextBlock x:Name="StatusText" Style="{StaticResource Audio.Caption}" Margin="0,12,0,0"/>
      </StackPanel></Border>
      <Border x:Name="PlayerCard" Style="{StaticResource Audio.Card}" Visibility="Collapsed"><StackPanel>
       <DockPanel Margin="0,0,0,16"><TextBlock x:Name="PlayerMeta" DockPanel.Dock="Right" Style="{StaticResource Audio.Caption}"/><TextBlock Text="播放器" FontWeight="SemiBold" FontSize="14"/></DockPanel>
       <Border Background="{DynamicResource Audio.Inset}" CornerRadius="10" BorderBrush="{DynamicResource Audio.Border}" BorderThickness="1" Height="104"><Grid><TextBlock x:Name="PlayerFile" Foreground="{DynamicResource Audio.Muted}" FontSize="12" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18"/><ProgressBar x:Name="PlaybackVisual" Height="3" Foreground="{DynamicResource Audio.Primary}" Background="Transparent" BorderThickness="0" VerticalAlignment="Bottom"/></Grid></Border>
       <DockPanel Margin="0,14,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="MP3" Click="RevealAudio_Click" Margin="8,0,0,0"/><Button x:Name="SubtitleButton" Content="SRT" Click="RevealSubtitle_Click" Margin="8,0,0,0"/></StackPanel><Button x:Name="PlayButton" DockPanel.Dock="Left" Width="40" Height="40" Style="{StaticResource Audio.PrimaryButton}" Padding="12" Click="Play_Click" AutomationProperties.Name="播放或暂停"><Path x:Name="PlayIcon" Data="M4,2 L18,12 4,22 Z" Fill="White" Width="13" Height="15" Stretch="Uniform"/></Button><TextBlock x:Name="PlaybackTime" Text="0:00 / 0:00" VerticalAlignment="Center" FontSize="12" FontFamily="Cascadia Code, Consolas" Margin="12,0"/><Slider x:Name="SeekInput" Minimum="0" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="False" PreviewMouseLeftButtonUp="Seek_Changed" AutomationProperties.Name="播放进度"/></DockPanel>
      </StackPanel></Border>
      <Border x:Name="SubtitleCard" Style="{StaticResource Audio.Card}" Visibility="Collapsed"><StackPanel><DockPanel Margin="0,0,0,16"><TextBlock x:Name="SubtitleCount" DockPanel.Dock="Right" Style="{StaticResource Audio.Caption}"/><TextBlock Text="字幕预览" FontSize="14" FontWeight="SemiBold"/></DockPanel><ListBox x:Name="SubtitleList" MaxHeight="200" AutomationProperties.Name="字幕预览"><ListBox.ItemTemplate><DataTemplate><Grid Margin="12,7"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Index}" Style="{StaticResource Audio.Caption}"/><TextBlock Grid.Column="1" Text="{Binding Time}" Style="{StaticResource Audio.Caption}" FontFamily="Cascadia Code, Consolas"/><TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="13" TextWrapping="Wrap"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
      <Border Style="{StaticResource Audio.Card}"><StackPanel><DockPanel Margin="0,0,0,16"><TextBlock x:Name="HistoryCount" DockPanel.Dock="Right" Style="{StaticResource Audio.Caption}"/><TextBlock Text="历史产物" FontSize="14" FontWeight="SemiBold"/></DockPanel><TextBlock x:Name="HistoryEmpty" Text="暂无历史文件" Style="{StaticResource Audio.Caption}" FontSize="13" HorizontalAlignment="Center" Margin="0,25"/><ListBox x:Name="HistoryList" MaxHeight="260" BorderThickness="0" Background="Transparent" MouseDoubleClick="History_Play" Visibility="Collapsed" AutomationProperties.Name="本次历史产物"><ListBox.ItemTemplate><DataTemplate><Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="34" Height="38" CornerRadius="8" HorizontalAlignment="Left" Background="{DynamicResource Audio.Soft}"><TextBlock Text="MP3" Foreground="{DynamicResource Audio.Primary}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Meta}" Style="{StaticResource Audio.Caption}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="2" Content="定位" Style="{StaticResource Audio.Mini}" Click="History_Reveal" Margin="10,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
     </StackPanel>
    </Grid>
   </StackPanel>
  </ScrollViewer>
 </Grid>
