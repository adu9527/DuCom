<Window x:Class="DuCom.Services.Plugins.CrcWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
  Title="CRC计算" Icon="/DuCom;component/Assets/DuCom.ico" Width="1040" Height="900" MinWidth="840" MinHeight="720"
 WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource Brush.ShellSurface}" Foreground="{DynamicResource Brush.TextPrimary}"
 FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" WindowStartupLocation="CenterScreen">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="PluginUiStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
  <Border BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="0,0,0,1" Background="{DynamicResource Brush.ShellSurface}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
   <Grid Margin="24,0,16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Data="M 2,2 L 18,2 L 18,18 L 2,18 Z M 6,6 L 14,6 M 6,10 L 14,10 M 6,14 L 10,14" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.5" Width="20" Height="20" Margin="0,0,10,0"/><TextBlock Text="CRC计算" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="14" FontWeight="Normal"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <CheckBox Content="置顶" IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" Margin="0,0,16,0"/>
     <Button Width="28" Height="28" Padding="0" Background="Transparent" Click="Minimize_Click" ToolTip="最小化" AutomationProperties.Name="最小化"><Path Data="M 0,5 L 10,5" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.2" Width="10" Height="10"/></Button>
     <Button x:Name="MaximizeButton" Width="28" Height="28" Padding="0" Background="Transparent" Click="Maximize_Click" ToolTip="最大化" AutomationProperties.Name="最大化">
      <Path x:Name="MaximizeIcon" Data="M 0,0 L 10,0 L 10,10 L 0,10 Z" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.2" Width="10" Height="10"/>
     </Button>
     <Button Width="28" Height="28" Padding="0" Background="Transparent" Click="Close_Click" ToolTip="关闭" AutomationProperties.Name="关闭"><Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.2" Width="10" Height="10"/></Button>
    </StackPanel>
   </Grid>
  </Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,24,32,24">
    <Grid Margin="0,0,0,8"><TextBlock Text="需要校验的数据"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><RadioButton x:Name="HexMode" Content="Hex" GroupName="InputMode" IsChecked="True" Checked="Mode_Changed" Margin="0,0,16,0"/><RadioButton x:Name="AsciiMode" Content="ASCII" GroupName="InputMode" Checked="Mode_Changed"/></StackPanel></Grid>
    <TextBox x:Name="DataInput" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" Height="150" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="Input_Changed" AutomationProperties.Name="需要校验的数据"/>
    <TextBlock x:Name="InputHint" Text="Hex：31 32 33 34，也支持连续字节和 0x 前缀。" FontSize="12" Margin="0,6,0,16" TextWrapping="Wrap"/>
    <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="参数模型 NAME"/><ComboBox x:Name="ModelSelect" Grid.Column="1" SelectionChanged="Model_Changed" AutomationProperties.Name="参数模型">
     <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox></Grid>
    <Grid x:Name="ParameterFields"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="宽度 WIDTH" Margin="0,0,0,6"/><ComboBox x:Name="WidthInput" SelectionChanged="Parameter_Changed" AutomationProperties.Name="宽度 WIDTH"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="多项式 POLY" Margin="0,0,0,6"/><TextBox x:Name="PolyInput" TextChanged="Input_Changed" AutomationProperties.Name="多项式 POLY"/></StackPanel>
     <StackPanel Grid.Column="4"><TextBlock Text="初始值 INIT" Margin="0,0,0,6"/><TextBox x:Name="InitInput" TextChanged="Input_Changed" AutomationProperties.Name="初始值 INIT"/></StackPanel>
     <StackPanel Grid.Column="6"><TextBlock Text="异或值 XOROUT" Margin="0,0,0,6"/><TextBox x:Name="XorInput" TextChanged="Input_Changed" AutomationProperties.Name="结果异或值 XOROUT"/></StackPanel>
    </Grid>
    <StackPanel Orientation="Horizontal" Margin="0,20,0,24"><CheckBox x:Name="RefInInput" Content="输入反转 REFIN" Click="Input_Changed" Margin="0,0,36,0"/><CheckBox x:Name="RefOutInput" Content="输出反转 REFOUT" Click="Input_Changed"/></StackPanel>
    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal"><Button x:Name="CalculateButton" Style="{StaticResource PluginUi.PrimaryButton}" Content="计算 CRC" Click="Calculate_Click" ToolTip="Ctrl+Enter"/><Button x:Name="FileButton" Content="校验文件…" Click="File_Click" Margin="8,0,0,0" ToolTip="按当前参数计算文件原始字节，最大 64 MiB"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="示例" Click="Example_Click" Background="Transparent"/><Button Content="清空" Click="Clear_Click" Background="Transparent"/></StackPanel>
    </Grid>
    <Border Background="{DynamicResource Brush.PanelSurface}" BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="24,20">
     <StackPanel>
      <Grid><TextBlock Text="校验结果 · Hex"/><Button x:Name="CopyHexButton" Content="复制 Hex" HorizontalAlignment="Right" Height="26" Background="Transparent" Click="CopyHex_Click" IsEnabled="False"/></Grid>
      <TextBox x:Name="HexResult" Text="—" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Brush.Accent}" FontSize="30" FontWeight="SemiBold" Padding="0,6" AutomationProperties.Name="Hex 结果"/>
      <TextBlock Text="高位在左、低位在右；协议的字节发送顺序请按实际要求处理。" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <Border Background="{DynamicResource Brush.PanelBorder}" Height="1"/>
      <Grid Margin="0,10,0,0"><TextBlock Text="校验结果 · Bin"/><Button x:Name="CopyBinButton" Content="复制 Bin" HorizontalAlignment="Right" Height="26" Background="Transparent" Click="CopyBin_Click" IsEnabled="False"/></Grid>
      <TextBox x:Name="BinResult" Text="—" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0,5" TextWrapping="Wrap" AutomationProperties.Name="Bin 结果"/>
     </StackPanel>
    </Border>
    <Expander Header="CRC 知识与参数说明"><TextBlock x:Name="HelpText" TextWrapping="Wrap" LineHeight="23" Margin="0,10,0,0"/></Expander>
    <Expander Header="常见 CRC 参数模型（21 种）">
     <StackPanel Margin="0,10,0,0"><TextBlock Text="双击模型可应用；横向滚动查看完整参数及多项式公式。" Margin="0,0,0,8"/>
      <DataGrid x:Name="ModelTable" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" HeadersVisibility="Column" Height="280" Background="{DynamicResource Brush.ControlSurface}" Foreground="{DynamicResource Brush.TextPrimary}" RowBackground="{DynamicResource Brush.PanelSurface}" AlternatingRowBackground="{DynamicResource Brush.PanelRaised}" BorderBrush="{DynamicResource Brush.ControlHover}" GridLinesVisibility="None" MouseDoubleClick="ModelTable_DoubleClick" SelectionMode="Single">
       <DataGrid.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource Brush.PanelBorder}"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/><Setter Property="Padding" Value="8"/></Style><Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,5"/></Style></DataGrid.Resources>
       <DataGrid.Columns><DataGridTextColumn Header="模型" Binding="{Binding Name}" Width="170"/><DataGridTextColumn Header="宽度" Binding="{Binding Width}"/><DataGridTextColumn Header="POLY" Binding="{Binding PolyHex}"/><DataGridTextColumn Header="INIT" Binding="{Binding InitHex}"/><DataGridTextColumn Header="XOROUT" Binding="{Binding XorHex}"/><DataGridTextColumn Header="REFIN" Binding="{Binding RefIn}"/><DataGridTextColumn Header="REFOUT" Binding="{Binding RefOut}"/><DataGridTextColumn Header="多项式公式" Binding="{Binding Formula}" Width="520"/></DataGrid.Columns>
      </DataGrid>
     </StackPanel>
    </Expander>
    <TextBlock Margin="0,16,0,0" FontSize="12" TextWrapping="Wrap">参考：<Hyperlink NavigateUri="https://www.ip33.com/crc.html" RequestNavigate="Reference_Navigate" Foreground="{DynamicResource Brush.Accent}">ip33.com CRC 计算</Hyperlink>　相关工具：<Hyperlink NavigateUri="https://www.ip33.com/lrc.html" RequestNavigate="Reference_Navigate" Foreground="{DynamicResource Brush.Accent}">LRC</Hyperlink> / <Hyperlink NavigateUri="https://www.ip33.com/bcc.html" RequestNavigate="Reference_Navigate" Foreground="{DynamicResource Brush.Accent}">BCC</Hyperlink></TextBlock>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="0,1,0,0" Padding="24,0"><TextBlock x:Name="StatusText" Text="输入数据或打开文件，选择模型后计算。" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></Border>
 </Grid>
</Window>
