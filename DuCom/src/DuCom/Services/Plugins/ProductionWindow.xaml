<Window x:Class="DuCom.Services.Plugins.ProductionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
  Title="耳机产测" Icon="/DuCom;component/Assets/DuCom.ico" Width="1180" Height="820" MinWidth="760" MinHeight="600" WindowStyle="None" ResizeMode="CanResize" Background="#09090B" Foreground="#F4F4F5" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="13" WindowStartupLocation="CenterScreen">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ProductionStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="72"/><RowDefinition Height="90"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border BorderBrush="#27272A" BorderThickness="0,0,0,1"><Grid Margin="24,0,12,0"><TextBlock Text="耳机产测" FontSize="15" FontWeight="SemiBold"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="—" Width="34" Padding="0" Background="Transparent" Click="Minimize_Click" AutomationProperties.Name="最小化"/><Button x:Name="MaximizeButton" Width="34" Padding="0" Background="Transparent" Click="Maximize_Click" AutomationProperties.Name="最大化"><Path Data="M 0,0 L 9,0 L 9,9 L 0,9 Z" Stroke="#A1A1AA" StrokeThickness="1.2"/></Button><Button Width="34" Padding="0" Background="Transparent" Click="Close_Click" AutomationProperties.Name="关闭"><Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="#A1A1AA" StrokeThickness="1.2"/></Button></StackPanel></Grid></Border>
   <Grid x:Name="ProjectBar" Grid.Row="1" Margin="24,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="项目" Foreground="#A1A1AA" Margin="0,0,12,0"/><ComboBox x:Name="Profiles" Grid.Column="1" MinWidth="180" MaxWidth="480" HorizontalAlignment="Stretch" Margin="0,0,20,0" SelectionChanged="Profiles_SelectionChanged"/><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="新建项目" Click="NewProject_Click" Margin="0,0,8,0"/><Button Content="删除项目" Click="DeleteProject_Click" Margin="0,0,8,0"/><Button Content="项目配置" Click="Configure_Click"/></StackPanel></Grid>
  <Grid x:Name="Connections" Grid.Row="2" Margin="24,0,24,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="LeftSelected" Content="左耳" IsChecked="True" Margin="0,0,12,0"/><ComboBox x:Name="LeftPort" Grid.Column="1" Margin="0,0,10,0"/><StackPanel Grid.Column="2" Orientation="Horizontal"><TextBlock x:Name="LeftState" Text="未连接" Foreground="#A1A1AA" Margin="0,0,10,0"/><Button x:Name="LeftConnect" Content="连接" Click="LeftConnect_Click"/></StackPanel></Grid></Border>
   <Border Grid.Column="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="RightSelected" Content="右耳" IsChecked="True" Margin="0,0,12,0"/><ComboBox x:Name="RightPort" Grid.Column="1" Margin="0,0,10,0"/><StackPanel Grid.Column="2" Orientation="Horizontal"><TextBlock x:Name="RightState" Text="未连接" Foreground="#A1A1AA" Margin="0,0,10,0"/><Button x:Name="RightConnect" Content="连接" Click="RightConnect_Click"/></StackPanel></Grid></Border>
  </Grid>
   <DataGrid x:Name="ResultsGrid" Grid.Row="3" Margin="24,0,24,16" ItemsSource="{Binding Rows}" IsReadOnly="True" RowHeight="52"><DataGrid.Columns><DataGridTextColumn Header="测试项" Binding="{Binding Name}" Width="1*"/>
    <DataGridTemplateColumn Header="左耳结果" Width="1.6*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Background="Transparent" MouseLeftButtonUp="Result_Click" Tag="left" Cursor="Hand"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><TextBlock Text="{Binding LeftShort}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="{Binding LeftMark}" Foreground="{Binding LeftBrush}" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn Header="右耳结果" Width="1.6*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Background="Transparent" MouseLeftButtonUp="Result_Click" Tag="right" Cursor="Hand"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><TextBlock Text="{Binding RightShort}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="{Binding RightMark}" Foreground="{Binding RightBrush}" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   </DataGrid.Columns></DataGrid>
   <Border Grid.Row="4" BorderBrush="#27272A" BorderThickness="0,1,0,0" Padding="24,16"><StackPanel>
    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="LeftSignalBox" Background="#18181B" CornerRadius="6" Padding="14,12"><TextBlock x:Name="LeftSignal" Text="左耳 · 待执行" FontSize="18" FontWeight="SemiBold"/></Border><Border x:Name="RightSignalBox" Grid.Column="2" Background="#18181B" CornerRadius="6" Padding="14,12"><TextBlock x:Name="RightSignal" Text="右耳 · 待执行" FontSize="18" FontWeight="SemiBold"/></Border></Grid>
    <WrapPanel><Button x:Name="StartButton" Content="开始" Width="90" Background="#164E63" Click="Start_Click"/><Button x:Name="ContinuousButton" Content="连续产测" Click="Continuous_Click" Margin="8,0,0,0" ToolTip="放入自动执行，完成后等待取走，再处理下一对"/><Button x:Name="StopButton" Content="停止" Width="70" Margin="8,0,16,0" Click="Stop_Click" IsEnabled="False"/><CheckBox x:Name="LoopSelected" Content="循环调试"/><Button x:Name="ClearBatchButton" Content="清空记录" Click="ClearBatch_Click" Margin="16,0,12,0" ToolTip="清空本批次结果和统计，保留已保存文件"/><CheckBox x:Name="FollowExecution" Content="跟随执行" IsChecked="True"/></WrapPanel>
    <TextBlock x:Name="StatusText" Text="就绪" Foreground="#A1A1AA" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="StatisticsText" Text="总数 0          通过 0          不通过 0          通过率 —" FontSize="14" Margin="0,14,0,0"/></StackPanel></Border>
 </Grid>
</Window>
