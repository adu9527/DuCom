<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DuCom.Plugins.BackgroundImage</AssemblyName>
    <RootNamespace>DuCom.Plugins.BackgroundImage</RootNamespace>
    <Version>1.0.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1031;CA1848</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DuCom.Plugin.Sdk\DuCom.Plugin.Sdk.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="plugin.manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
